{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sk-immigration-website",
  "account_id": "e480701d9e4150072f4f9a09b43e9749",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "workers_dev": true,
  "vars": {
    "GITHUB_REPO": "Salaroutsourcing/sk-immigration-website",
    "STUDIO_GITHUB_ALLOWLIST": "Salaroutsourcing,isajidkhan00"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sk-immigration-leads",
      "database_id": "325db95e-0aa9-4e8d-aae2-ad57275bc003"
    }
  ],
  "routes": [
    {
      "pattern": "immigration.salaroutsourcing.com",
      "custom_domain": true
    },
    {
      "pattern": "www.salaroutsourcing.com/*",
      "zone_name": "salaroutsourcing.com"
    },
    {
      "pattern": "salaroutsourcing.com/*",
      "zone_name": "salaroutsourcing.com"
    }
  ]
}

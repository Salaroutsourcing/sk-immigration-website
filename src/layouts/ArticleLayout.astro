---
import BaseLayout from './BaseLayout.astro';
import AffiliateCard from '../components/content/AffiliateCard.astro';
import StoryToBlogCta from '../components/content/StoryToBlogCta.astro';
import ArticleToc from '../components/content/ArticleToc.astro';
import ArticleSidebar from '../components/content/ArticleSidebar.astro';
import ArticleCta from '../components/content/ArticleCta.astro';
import ContinueReading from '../components/content/ContinueReading.astro';
import OfficialSources from '../components/content/OfficialSources.astro';
import { coverImageFor, topicLabel, type OfficialSource, type RelatedLink, type TocItem } from '../lib/article';

interface Props {
  title: string;
  description: string;
  canonical: string;
  published: Date;
  updated?: Date;
  image?: string;
  jsonLd?: unknown[];
  page?: string;
  category?: string;
  crumbs: { name: string; path: string }[];
  faqs?: { question: string; answer: string }[];
  affiliates?: { title: string; url: string; blurb: string }[];
  relatedBlogHref?: string;
  relatedBlogTitle?: string;
  toc?: TocItem[];
  readingMinutes?: number;
  relatedItems?: RelatedLink[];
  relatedServices?: { href: string; title: string }[];
  officialSources?: OfficialSource[];
}

const {
  title,
  description,
  canonical,
  published,
  updated,
  image,
  jsonLd,
  page,
  category,
  crumbs,
  faqs,
  affiliates,
  relatedBlogHref,
  relatedBlogTitle,
  toc = [],
  readingMinutes,
  relatedItems = [],
  relatedServices = [],
  officialSources = [],
} = Astro.props;

const displayTitle = title.replace(/\s*\|\s*SK Immigration.*$/, '');
const publishedLabel = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const updatedLabel = updated
  ? updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
const categoryLabel = topicLabel(category);
const cover = coverImageFor({ image, cluster: page, category });
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={cover}
  published={published}
  updated={updated}
  jsonLd={jsonLd}
  page={page}
>
  <article class="mx-auto max-w-5xl px-4 py-6 sm:px-6 md:py-8">
    <nav aria-label="Breadcrumb" class="mb-3">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        {crumbs.map((crumb, i) => (
          <>
            {i > 0 && <li aria-hidden="true">/</li>}
            <li>
              {i === crumbs.length - 1 ? (
                <span class="font-medium text-slate-900 dark:text-white">{crumb.name}</span>
              ) : (
                <a href={crumb.path} class="hover:text-primary-600">{crumb.name}</a>
              )}
            </li>
          </>
        ))}
      </ol>
    </nav>

    <header class="mx-auto mb-5 max-w-3xl">
      {category && <p class="eyebrow mb-2">{categoryLabel}</p>}
      <p class="mb-2 text-sm text-muted">
        <time datetime={published.toISOString()}>{publishedLabel}</time>
        <span aria-hidden="true"> · </span>
        <span>SK Immigration</span>
        {readingMinutes && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{readingMinutes} min read</span>
          </>
        )}
        {updatedLabel && updated && (
          <>
            <span aria-hidden="true"> · </span>
            <span>Updated {updatedLabel}</span>
          </>
        )}
      </p>
      <h1 class="font-heading text-3xl font-bold leading-[1.15] tracking-tight text-ink sm:text-4xl md:text-5xl dark:text-white">
        {displayTitle}
      </h1>
      <p class="mt-3 text-lg leading-snug text-slate-500 dark:text-slate-400">{description}</p>
      <img
        src={cover}
        alt=""
        class="mt-6 w-full rounded-md object-cover aspect-[16/9] max-h-[28rem]"
        width="960"
        height="540"
      />
    </header>

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <div class="min-w-0">
        <ArticleToc items={toc} variant="panel" />
        <div class="prose prose-slate article-prose prose-headings:font-heading prose-headings:font-bold prose-a:text-primary-600 prose-img:rounded-md dark:prose-invert">
          <slot />
        </div>
        <OfficialSources sources={officialSources} />

        {relatedBlogHref && relatedBlogTitle && (
          <StoryToBlogCta title={relatedBlogTitle} href={relatedBlogHref} />
        )}
        {affiliates?.map((item) => <AffiliateCard {...item} />)}

        {faqs && faqs.length > 0 && (
          <section class="not-prose mt-7 border-t border-slate-200 pt-5 dark:border-slate-800">
            <h2 class="mb-3 font-heading text-xl font-bold text-slate-900 dark:text-white">Frequently asked questions</h2>
            <div class="space-y-1.5">
              {faqs.map((faq) => (
                <details class="group rounded-xl border border-line bg-page px-4 py-2.5 dark:border-slate-800 dark:bg-slate-900">
                  <summary class="flex cursor-pointer list-none items-center justify-between font-heading text-base font-bold text-slate-900 dark:text-white">
                    <span>{faq.question}</span>
                    <span class="ml-4 text-primary-600 transition-transform group-open:rotate-180">▾</span>
                  </summary>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <ArticleCta />
        <ContinueReading items={relatedItems} />
      </div>

      <div class="lg:mt-0">
        <ArticleSidebar services={relatedServices}>
          <ArticleToc items={toc} variant="aside" />
        </ArticleSidebar>
      </div>
    </div>
  </article>
  <script is:inline>
    (function () {
      var root = document.querySelector('.article-prose');
      if (!root) return;
      function slug(text) {
        return String(text || '')
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }
      root.querySelectorAll('h2, h3').forEach(function (heading) {
        if (!heading.id) heading.id = slug(heading.textContent);
      });
      root.querySelectorAll('table').forEach(function (table) {
        if (table.parentElement && table.parentElement.classList.contains('table-scroll')) return;
        var wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        table.parentNode.insertBefore(wrap, table);
        wrap.appendChild(table);
      });
    })();
  </script>
</BaseLayout>

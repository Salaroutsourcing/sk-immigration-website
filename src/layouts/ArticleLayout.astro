---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import AdsterraSlot from '../components/ads/AdSlot.astro';
import AffiliateCard from '../components/content/AffiliateCard.astro';
import StoryToBlogCta from '../components/content/StoryToBlogCta.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  published: Date;
  updated?: Date;
  image?: string;
  jsonLd?: unknown[];
  page?: string;
  category?: string;
  crumbs: { name: string; path: string }[];
  faqs?: { question: string; answer: string }[];
  affiliates?: { title: string; url: string; blurb: string }[];
  relatedBlogHref?: string;
  relatedBlogTitle?: string;
}

const {
  title,
  description,
  canonical,
  published,
  updated,
  image,
  jsonLd,
  page,
  category,
  crumbs,
  faqs,
  affiliates,
  relatedBlogHref,
  relatedBlogTitle,
} = Astro.props;

const publishedLabel = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={image}
  published={published}
  updated={updated}
  jsonLd={jsonLd}
  page={page}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 md:py-12">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        {crumbs.map((crumb, i) => (
          <>
            {i > 0 && <li aria-hidden="true">/</li>}
            <li>
              {i === crumbs.length - 1 ? (
                <span class="font-medium text-slate-900 dark:text-white">{crumb.name}</span>
              ) : (
                <a href={crumb.path} class="hover:text-primary-600">{crumb.name}</a>
              )}
            </li>
          </>
        ))}
      </ol>
    </nav>

    <header class="mb-8">
      {category && (
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-primary-600 dark:text-blue-400">
          {category.replace('-', ' ')}
        </p>
      )}
      <h1 class="mb-4 font-heading text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl md:text-5xl dark:text-white">
        {title.replace(/\s*\|\s*SK Immigration.*$/, '')}
      </h1>
      <p class="mb-4 text-lg text-slate-600 dark:text-slate-400">{description}</p>
      <div class="flex flex-wrap items-center gap-4 border-y border-slate-100 py-3 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
        <time datetime={published.toISOString()}>{publishedLabel}</time>
        <span>·</span>
        <span>SK Immigration Advisory Team</span>
      </div>
      <div class="mt-4 text-sm text-muted dark:text-slate-400">
        Visa rules come from official embassy sources. Embassies decide every outcome.
      </div>
    </header>

    <AdSlot slotId="1122334455" format="horizontal" />
    <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:font-bold prose-a:text-primary-600 prose-img:rounded-2xl dark:prose-invert">
      <slot />
    </div>
    <AdSlot slotId="9876543210" format="auto" />
    <AdsterraSlot placement="in-article" />

    {relatedBlogHref && relatedBlogTitle && (
      <StoryToBlogCta title={relatedBlogTitle} href={relatedBlogHref} />
    )}
    {affiliates?.map((item) => <AffiliateCard {...item} />)}

    {faqs && faqs.length > 0 && (
      <section class="not-prose mt-12 border-t border-slate-200 pt-8 dark:border-slate-800">
        <h2 class="mb-6 font-heading text-2xl font-bold text-slate-900 dark:text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-lg border border-gray-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
              <summary class="flex cursor-pointer list-none items-center justify-between font-heading text-base font-bold text-slate-900 dark:text-white">
                <span>{faq.question}</span>
                <span class="ml-4 text-primary-600 transition-transform group-open:rotate-180">▾</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="not-prose mt-12 rounded-md bg-slate-50 px-6 py-10 text-center dark:bg-slate-900">
      <h3 class="font-heading mb-2 text-2xl font-bold text-slate-900 dark:text-white">Questions about this pathway?</h3>
      <p class="mx-auto mb-6 max-w-md text-muted dark:text-slate-400">
        Tell us what you're planning. We prepare files — authorities decide. We never sell guarantees.
      </p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/contact/" class="btn-primary">Start My Assessment</a>
        <a href="/services/" class="btn">Explore Services</a>
      </div>
    </div>
  </article>
</BaseLayout>

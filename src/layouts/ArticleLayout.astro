---
import BaseLayout from './BaseLayout.astro';
import AffiliateCard from '../components/content/AffiliateCard.astro';
import StoryToBlogCta from '../components/content/StoryToBlogCta.astro';
import ArticleToc from '../components/content/ArticleToc.astro';
import ArticleSidebar from '../components/content/ArticleSidebar.astro';
import ArticleCta from '../components/content/ArticleCta.astro';
import ContinueReading from '../components/content/ContinueReading.astro';
import OfficialSources from '../components/content/OfficialSources.astro';
import CountryGuideNav from '../components/content/CountryGuideNav.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import { coverImageFor, topicLabel, type OfficialSource, type RelatedLink, type TocItem } from '../lib/article';

interface Props {
  title: string;
  description: string;
  canonical: string;
  published: Date;
  updated?: Date;
  image?: string;
  jsonLd?: unknown[];
  page?: string;
  category?: string;
  country?: string;
  crumbs: { name: string; path: string }[];
  faqs?: { question: string; answer: string }[];
  affiliates?: { title: string; url: string; blurb: string }[];
  relatedBlogHref?: string;
  relatedBlogTitle?: string;
  toc?: TocItem[];
  readingMinutes?: number;
  relatedItems?: RelatedLink[];
  relatedServices?: { href: string; title: string }[];
  officialSources?: OfficialSource[];
}

const {
  title,
  description,
  canonical,
  published,
  updated,
  image,
  jsonLd,
  page,
  category,
  country,
  crumbs,
  faqs,
  affiliates,
  relatedBlogHref,
  relatedBlogTitle,
  toc = [],
  readingMinutes,
  relatedItems = [],
  relatedServices = [],
  officialSources = [],
} = Astro.props;

const displayTitle = title.replace(/\s*\|\s*SK Immigration.*$/, '');
const publishedLabel = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const updatedLabel = updated
  ? updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
const categoryLabel = topicLabel(category);
const cover = coverImageFor({ image, cluster: page, category });
const mappedFaqs = (faqs ?? []).map((faq) => ({ q: faq.question, a: faq.answer }));
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  image={cover}
  published={published}
  updated={updated}
  jsonLd={jsonLd}
  page={page}
>
  <article class="sk-article">
    <header class="sk-article-head">
      <nav class="sk-crumb" aria-label="Breadcrumb">
        {crumbs.map((crumb, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {i === crumbs.length - 1 ? (
              <span class="text-navy">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            )}
          </>
        ))}
      </nav>
      {category && <p class="sk-eyebrow">{categoryLabel}</p>}
      <h1>{displayTitle}</h1>
      <p class="sk-article-summary">{description}</p>
      <p class="sk-article-meta">
        <time datetime={published.toISOString()}>{publishedLabel}</time>
        {readingMinutes && <span>{readingMinutes} min read</span>}
        {updatedLabel && updated && <span>Updated {updatedLabel}</span>}
      </p>
    </header>
    <img class="sk-article-cover" src={cover} alt="" width="960" height="540" />
    {country && <CountryGuideNav country={country} />}
    <div class="sk-wrap grid items-start gap-10 lg:grid-cols-[minmax(0,760px)_16rem]">
      <div class="min-w-0">
        <ArticleToc items={toc} variant="panel" />
        <div class="prose prose-slate article-prose max-w-none prose-headings:font-heading prose-headings:font-bold prose-a:text-navy prose-img:rounded-md dark:prose-invert">
          <slot />
        </div>
        <OfficialSources sources={officialSources} />
        {relatedBlogHref && relatedBlogTitle && <StoryToBlogCta title={relatedBlogTitle} href={relatedBlogHref} />}
        {affiliates?.map((item) => <AffiliateCard {...item} />)}
        {mappedFaqs.length > 0 && (
          <section class="not-prose mt-10">
            <h2 class="mb-4 text-2xl font-bold tracking-tight text-navy">Frequently asked questions</h2>
            <FaqAccordion faqs={mappedFaqs} />
          </section>
        )}
        <ArticleCta />
        <ContinueReading items={relatedItems} />
      </div>
      <div>
        <ArticleSidebar services={relatedServices}>
          <ArticleToc items={toc} variant="aside" />
        </ArticleSidebar>
      </div>
    </div>
  </article>
  <script is:inline>
    (function () {
      var root = document.querySelector('.article-prose');
      if (!root) return;
      function slug(text) {
        return String(text || '')
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }
      root.querySelectorAll('h2, h3').forEach(function (heading) {
        if (!heading.id) heading.id = slug(heading.textContent);
      });
      root.querySelectorAll('table').forEach(function (table) {
        if (table.parentElement && table.parentElement.classList.contains('table-scroll')) return;
        var wrap = document.createElement('div');
        wrap.className = 'table-scroll';
        table.parentNode.insertBefore(wrap, table);
        wrap.appendChild(table);
      });
    })();
  </script>
</BaseLayout>

---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ClusterNotice from '../components/ClusterNotice.astro';
import { HUB_META, landerPath, type LanderEntry } from '../lib/landers';
import { basePageGraph } from '../lib/seo';

interface Props {
  entry: LanderEntry;
}

const { entry } = Astro.props;
const { cluster, slug, title, h1, description, image, publishDate, faqs, body } = entry.data;
const hub = HUB_META[cluster];
const path = landerPath(entry);
const hubPath = cluster === 'guides' ? '/guides/' : `/${cluster}/`;
const crumbs =
  slug === 'index' || slug === 'hub'
    ? [
        { name: 'Home', path: '/' },
        { name: h1, path },
      ]
    : [
        { name: 'Home', path: '/' },
        { name: hub?.title || cluster, path: hubPath },
        { name: h1, path },
      ];
const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  image={image}
  type="article"
  published={publishDate}
  page={cluster}
  jsonLd={[
    ...basePageGraph(crumbs),
    ...(faqSchema ? [faqSchema] : []),
  ]}
>
  <article class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-primary-600">Home</a>
      <span aria-hidden="true"> / </span>
      {slug !== 'index' && slug !== 'hub' && (
        <>
          <a href={hubPath} class="hover:text-primary-600">{hub?.title || cluster}</a>
          <span aria-hidden="true"> / </span>
        </>
      )}
      <span class="font-medium text-slate-900 dark:text-white">{h1}</span>
    </nav>

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">{hub?.kicker}</p>
        <h1 class="mb-4 font-heading text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">
          {h1}
        </h1>
        <p class="mb-6 text-lg text-slate-600 dark:text-slate-400">{description}</p>
        <ClusterNotice cluster={cluster} slug={slug} />
        <div class="mb-6 rounded-lg border border-gray-200 bg-slate-50 p-4 text-sm text-muted dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
          Educational resource. Embassy rules change — verify official links. We prepare files. Authorities decide.
        </div>
        <AdSlot slotId="1122334455" format="horizontal" />
        <div
          class="prose prose-slate max-w-none prose-headings:font-heading prose-a:text-primary-600 prose-table:text-sm dark:prose-invert"
          set:html={body}
        />
        {faqs.length > 0 && (
          <section class="not-prose mt-12 border-t border-slate-200 pt-8 dark:border-slate-800">
            <h2 class="mb-6 font-heading text-2xl font-bold text-slate-900 dark:text-white">Frequently asked questions</h2>
            <div class="space-y-3">
              {faqs.map((faq) => (
                <details class="group rounded-lg border border-gray-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
                  <summary class="flex cursor-pointer list-none items-center justify-between font-heading font-bold text-slate-900 dark:text-white">
                    <span>{faq.question}</span>
                    <span class="ml-4 text-primary-600 group-open:rotate-180">▾</span>
                  </summary>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
        <div class="not-prose mt-12 rounded-md bg-slate-50 px-6 py-10 text-center dark:bg-slate-900">
          <h2 class="font-heading mb-2 text-2xl font-bold text-slate-900 dark:text-white">Start an assessment</h2>
          <p class="mx-auto mb-6 max-w-md text-muted dark:text-slate-400">
            Tell us what you're planning. We prepare files — authorities decide.
          </p>
          <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/contact/" class="btn-primary">Start My Assessment</a>
            <a href="/services/" class="btn">Explore Services</a>
          </div>
        </div>
      </div>
      <aside class="space-y-4 lg:sticky lg:top-24">
        <div class="rounded-lg border border-gray-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="mb-2 font-heading text-base font-bold text-slate-900 dark:text-white">Ask us about your situation</h2>
          <p class="mb-4 text-sm text-muted dark:text-slate-400">Honest timeline and document review. No visa guarantees.</p>
          <a href="/contact/" class="btn-primary w-full px-5 py-2.5 text-sm">Start Assessment</a>
        </div>
        <AdSlot slotId="9876543210" format="rectangle" />
        <div class="rounded-lg border border-gray-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="mb-3 font-heading text-base font-bold text-slate-900 dark:text-white">Popular guides</h2>
          <ul class="space-y-2 text-sm">
            <li><a class="text-primary-600 hover:underline" href="/study-visa/germany-study-visa-pakistan/">Germany study visa</a></li>
            <li><a class="text-primary-600 hover:underline" href="/study-visa/uk-study-visa-pakistan/">UK student visa</a></li>
            <li><a class="text-primary-600 hover:underline" href="/study-visa/canada-study-visa-pakistan/">Canada study permit</a></li>
            <li><a class="text-primary-600 hover:underline" href="/saudi-visa/saudi-visa-processing-pakistan/">Saudi work visa PKR 15k</a></li>
            <li><a class="text-primary-600 hover:underline" href="/visit-visa/dubai-visit-visa-pakistan/">Dubai visit visa</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

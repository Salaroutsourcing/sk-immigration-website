---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ClusterNotice from '../components/ClusterNotice.astro';
import ArticleToc from '../components/content/ArticleToc.astro';
import ArticleSidebar from '../components/content/ArticleSidebar.astro';
import ArticleCta from '../components/content/ArticleCta.astro';
import ContinueReading from '../components/content/ContinueReading.astro';
import OfficialSources from '../components/content/OfficialSources.astro';
import { HUB_META, landerPath, relatedLanders, type LanderEntry } from '../lib/landers';
import { basePageGraph } from '../lib/seo';
import {
  headingsFromHtml,
  officialSourcesFor,
  prepareArticleHtml,
  readingMinutesFromText,
  relatedServicesFor,
} from '../lib/article';

interface Props {
  entry: LanderEntry;
}

const { entry } = Astro.props;
const { cluster, slug, title, h1, description, image, publishDate, faqs, body } = entry.data;
const hub = HUB_META[cluster];
const path = landerPath(entry);
const hubPath = cluster === 'guides' ? '/guides/' : `/${cluster}/`;
const articleHtml = prepareArticleHtml(body);
const toc = headingsFromHtml(articleHtml);
const readingMinutes = readingMinutesFromText(body);
const services = relatedServicesFor(cluster);
const officialSources = officialSourcesFor(cluster);
const relatedItems = (await relatedLanders(entry, 4)).map((item) => ({
  href: landerPath(item),
  title: item.data.h1,
  category: HUB_META[item.data.cluster]?.kicker,
  description: item.data.description,
}));
const publishedLabel = publishDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const crumbs =
  slug === 'index' || slug === 'hub'
    ? [
        { name: 'Home', path: '/' },
        { name: h1, path },
      ]
    : [
        { name: 'Home', path: '/' },
        { name: hub?.title || cluster, path: hubPath },
        { name: h1, path },
      ];
const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  image={image}
  type="article"
  published={publishDate}
  page={cluster}
  jsonLd={[
    ...basePageGraph(crumbs),
    ...(faqSchema ? [faqSchema] : []),
  ]}
>
  <article class="mx-auto max-w-6xl px-4 py-6 sm:px-6 md:py-10">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-primary-600">Home</a>
      <span aria-hidden="true"> / </span>
      {slug !== 'index' && slug !== 'hub' && (
        <>
          <a href={hubPath} class="hover:text-primary-600">{hub?.title || cluster}</a>
          <span aria-hidden="true"> / </span>
        </>
      )}
      <span class="font-medium text-slate-900 dark:text-white">{h1}</span>
    </nav>

    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_16.5rem] lg:gap-12">
      <div class="min-w-0">
        <header class="mb-5 max-w-3xl">
          <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">{hub?.kicker}</p>
          <h1 class="mb-3 font-heading text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
            {h1}
          </h1>
          <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
            <time datetime={publishDate.toISOString()}>{publishedLabel}</time>
            <span aria-hidden="true">·</span>
            <span>{readingMinutes} min read</span>
          </div>
          <p class="text-[1.0625rem] leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>
        </header>
        <ClusterNotice cluster={cluster} slug={slug} />
        <ArticleToc items={toc} variant="panel" />
        <AdSlot slotId="1122334455" format="horizontal" />
        <div
          class="prose prose-slate article-prose prose-headings:font-heading prose-a:text-primary-600 prose-table:text-sm dark:prose-invert"
          set:html={articleHtml}
        />
        <OfficialSources sources={officialSources} />
        {faqs.length > 0 && (
          <section class="not-prose mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
            <h2 class="mb-4 font-heading text-xl font-bold text-slate-900 dark:text-white">Frequently asked questions</h2>
            <div class="space-y-2">
              {faqs.map((faq) => (
                <details class="group rounded-lg border border-gray-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-900">
                  <summary class="flex cursor-pointer list-none items-center justify-between font-heading font-bold text-slate-900 dark:text-white">
                    <span>{faq.question}</span>
                    <span class="ml-4 text-primary-600 group-open:rotate-180">▾</span>
                  </summary>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
        <ArticleCta />
        <ContinueReading items={relatedItems} />
      </div>
      <div>
        <ArticleSidebar services={services}>
          <ArticleToc items={toc} variant="aside" />
        </ArticleSidebar>
        <div class="mt-4 hidden lg:block">
          <AdSlot slotId="9876543210" format="rectangle" />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

---
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Announcement from '../components/Announcement.astro';
import { SITE, ANALYTICS } from '../lib/config';
import { SITE as CORE } from '../lib/site';
import { organizationSchema, websiteSchema, localBusinessSchema, digitalOrganizationSchema, digitalWebsiteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  canonicalUrl?: string;
  ogImage?: string;
  image?: string;
  ogType?: 'website' | 'article';
  type?: 'website' | 'article';
  jsonLd?: unknown | unknown[];
  noIndex?: boolean;
  noindex?: boolean;
  published?: Date;
  updated?: Date;
  page?: string;
  amphtml?: string;
  keywords?: string;
  schemaVariant?: 'local' | 'global';
}

const {
  title,
  description = SITE.description,
  canonical,
  canonicalUrl,
  ogImage,
  image,
  ogType,
  type,
  jsonLd,
  noIndex,
  noindex,
  published,
  updated,
  page = 'content',
  amphtml,
  keywords,
  schemaVariant = 'local',
} = Astro.props;

const pageTitle = title
  ? title.includes('SK Immigration')
    ? title
    : `${title} | SK Immigration Services`
  : CORE.seoTitle;

const canonicalPath = canonicalUrl ?? canonical ?? Astro.url.pathname;
const imagePath = ogImage ?? image ?? CORE.defaultOg;
const extraJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const baseSchemas =
  schemaVariant === 'global'
    ? [digitalOrganizationSchema(), digitalWebsiteSchema(), organizationSchema(), localBusinessSchema()]
    : [organizationSchema(), localBusinessSchema(), websiteSchema()];
const schemas = [...baseSchemas, ...extraJsonLd];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SeoHead
      title={pageTitle}
      description={description}
      canonical={canonicalPath}
      type={ogType ?? type ?? 'website'}
      image={imagePath}
      published={published}
      updated={updated}
      noindex={noIndex ?? noindex}
      jsonLd={schemas}
      amphtml={amphtml}
      keywords={keywords}
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-white transition-colors duration-200 dark:bg-dark-950" data-page={page}>
    {ANALYTICS.gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${ANALYTICS.gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>
    <Announcement />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <slot name="scripts" />
  </body>
</html>

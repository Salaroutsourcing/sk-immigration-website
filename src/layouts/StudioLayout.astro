---
import '../styles/studio.css';

interface Props {
  title?: string;
}

const { title = 'SK Immigration Studio' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta
      name="description"
      content="Private publishing studio for SK Immigration Services. Not indexed."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href="https://immigration.salaroutsourcing.com/studio/" />
    <link rel="icon" href="/assets/img/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('sk-studio-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="studio-body">
    <div id="studio-static" style="min-height:100vh;display:grid;place-items:center;padding:24px;background:#09090b;color:#f4f4f5;font-family:ui-sans-serif,system-ui,sans-serif">
      <div class="card" style="width:min(100%,420px);padding:28px;border:1px solid rgba(255,255,255,.08);border-radius:16px;background:#111114">
        <h1 style="margin:0 0 8px;font-size:1.5rem">SK Immigration Studio</h1>
        <p style="margin:0 0 14px;color:#a1a1aa;line-height:1.5">Loading the editor. If this box stays here, tap the gold button.</p>
        <a href="https://immigration.salaroutsourcing.com/studio/" style="display:inline-block;color:#111;background:#c9a84c;font-weight:700;text-decoration:none;padding:12px 16px;border-radius:10px">Open Studio</a>
      </div>
    </div>
    <slot />
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  page?: string;
}

const { title, description, canonical, noindex, jsonLd, page = 'studio' } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  jsonLd={jsonLd}
  page={page}
>
  <slot />
</BaseLayout>

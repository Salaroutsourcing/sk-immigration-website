---
import '../styles/studio.css';

interface Props {
  title?: string;
}

const { title = 'SK Immigration Studio' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta
      name="description"
      content="Private publishing studio for SK Immigration Services. Not indexed."
    />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href="https://immigration.salaroutsourcing.com/studio/" />
    <link rel="icon" href="/assets/img/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('sk-studio-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="studio-body">
    <div id="studio-static" class="login-screen">
      <div class="login-card">
        <div class="login-brand">
          <img src="/assets/img/logo.jpg" alt="" />
          <div>
            <div class="login-kicker">SK Immigration</div>
            <strong>Studio</strong>
          </div>
        </div>
        <h1>Sign in to publish</h1>
        <p class="lede">Private console for news, blogs, and Web Stories.</p>
        <p id="studio-html-error" class="login-error" hidden></p>
        <a class="btn btn-gold btn-block" href="/api/auth/github">Continue with GitHub</a>
        <form method="post" action="/api/auth/login" style="margin-top: 18px">
          <input type="hidden" name="redirect" value="/studio/" />
          <div class="field">
            <label for="studio-password-html">Password</label>
            <input
              id="studio-password-html"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </div>
          <button class="btn btn-gold btn-block" type="submit">Sign in with password</button>
        </form>
      </div>
    </div>
    <script is:inline>
      (function () {
        var params = new URLSearchParams(location.search);
        var code = params.get('error') || '';
        var map = {
          invalid_password: 'Wrong password. Try again.',
          oauth_config: 'GitHub sign-in is not connected yet. Use the password below.',
          oauth_state: 'GitHub sign-in was interrupted. Use the password below.',
          oauth_expired: 'The GitHub sign-in link expired. Use the password below.',
          not_allowlisted: 'That GitHub account is not allowed. Use the password below.',
        };
        if (!code) return;
        var el = document.getElementById('studio-html-error');
        if (!el) return;
        el.hidden = false;
        el.textContent = map[code] || 'Sign-in failed. Try the password.';
      })();
    </script>
    <slot />
  </body>
</html>

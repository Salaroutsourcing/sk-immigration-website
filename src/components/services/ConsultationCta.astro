---
import ServiceIcon from './ServiceIcon.astro';
---

<section class="consult-cta reveal" aria-labelledby="consult-heading">
  <div class="consult-cta__inner">
    <span class="consult-cta__icon" aria-hidden="true">
      <ServiceIcon name="chat" class="h-6 w-6" />
    </span>
    <div class="consult-cta__copy">
      <h2 id="consult-heading">Need help choosing the right service?</h2>
      <p>
        Your first assessment is free. Tell us what you are planning — you do not need a perfect pathway before you
        start. We will outline the likely next steps and a written scope before any paid work.
      </p>
    </div>
    <a class="consult-cta__btn" href="/contact/">Get Free Consultation →</a>
  </div>
</section>

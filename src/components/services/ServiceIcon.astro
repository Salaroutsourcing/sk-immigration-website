---
interface Props {
  name:
    | 'graduation'
    | 'briefcase'
    | 'home'
    | 'shield'
    | 'passport'
    | 'document'
    | 'calendar'
    | 'lock'
    | 'guidance'
    | 'bolt'
    | 'globe'
    | 'chat'
    | 'check';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg class={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
  {name === 'graduation' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M3.75 9.75 12 5.25l8.25 4.5L12 14.25 3.75 9.75zM6.75 12.15v3.6c0 .5 2.1 2.25 5.25 2.25s5.25-1.75 5.25-2.25v-3.6M19.5 11.4v5.1"
    />
  )}
  {name === 'briefcase' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M8 7V5.75A1.75 1.75 0 0 1 9.75 4h4.5A1.75 1.75 0 0 1 16 5.75V7M4.75 9.5h14.5A1.75 1.75 0 0 1 21 11.25v7A1.75 1.75 0 0 1 19.25 20H4.75A1.75 1.75 0 0 1 3 18.25v-7A1.75 1.75 0 0 1 4.75 9.5zM3 13.25h18"
    />
  )}
  {name === 'home' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.5 10.5 12 4.5l7.5 6V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19v-8.5zM9.75 20.5v-5.25h4.5v5.25"
    />

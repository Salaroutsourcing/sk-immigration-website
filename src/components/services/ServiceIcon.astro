  {name === 'shield' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3.5 19 6.5v5.1c0 4.15-2.85 7.85-7 9.4-4.15-1.55-7-5.25-7-9.4V6.5L12 3.5zM9.25 12.25l1.85 1.85 3.9-4.1"
    />
  )}
  {name === 'passport' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M7 4.5h7.5L18.5 8.5V19a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 19V6A1.5 1.5 0 0 1 7 4.5zM14.5 4.5V8.5h4M9 12.25h6M9 15.25h4.5M12 9.4a1.35 1.35 0 1 0 0-2.7 1.35 1.35 0 0 0 0 2.7z"
    />
  )}
  {name === 'document' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M7.25 4.5h6.5L18.5 9v10.5A1.5 1.5 0 0 1 17 21H7.25A1.5 1.5 0 0 1 5.75 19.5V6A1.5 1.5 0 0 1 7.25 4.5zM13.75 4.5V9h4.25M8.75 13h6.5M8.75 16.25h4.75"
    />
  )}
  {name === 'calendar' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M7 5v2.5M17 5v2.5M4.75 9.25h14.5M6.25 6.5h11.5A1.75 1.75 0 0 1 19.5 8.25v10A1.75 1.75 0 0 1 17.75 20H6.25A1.75 1.75 0 0 1 4.5 18.25v-10A1.75 1.75 0 0 1 6.25 6.5zM8.5 12.5h.5M12 12.5h.5M15.5 12.5h.5M8.5 15.75h.5M12 15.75h.5"
    />
  )}
  {name === 'lock' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M8 11V8.5a4 4 0 1 1 8 0V11M7.25 11h9.5A1.75 1.75 0 0 1 18.5 12.75v6A1.75 1.75 0 0 1 16.75 20.5H7.25A1.75 1.75 0 0 1 5.5 18.75v-6A1.75 1.75 0 0 1 7.25 11z"
    />
  )}
  {name === 'guidance' && (
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 4.5 13.2 8h3.8L13.9 10.4 15.1 14 12 11.9 8.9 14l1.2-3.6L7 8h3.8L12 4.5zM6.5 18.5h11"
    />
  )}
  {name === 'bolt' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M13 3.75 6.75 13.5h5.1L11 20.25 17.25 10.5h-5.1L13 3.75z" />

      stroke-linejoin="round"
      d="M5.5 6.5h13A1.5 1.5 0 0 1 20 8v7.5a1.5 1.5 0 0 1-1.5 1.5H9.5L5 20.5V8a1.5 1.5 0 0 1 1.5-1.5z"
    />
  )}
  {name === 'check' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 12.5 9.75 16.75 18.5 7.5" />
  )}
</svg>

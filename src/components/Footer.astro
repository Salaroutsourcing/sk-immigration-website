---
import { SITE, CONTACT, SOCIAL } from '../lib/config';

const currentYear = new Date().getFullYear();
const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Study & Admissions', href: '/study-visa/' },
      { label: 'Visit & Tourist Visas', href: '/visit-visa/' },
      { label: 'Work & Training', href: '/work-permit/' },
      { label: 'Document Services', href: '/document-services/' },
      { label: 'Appointments', href: '/visa-appointment/' },
      { label: 'Saudi Processing', href: '/saudi-visa/' },
      { label: 'Company Registration', href: '/business-registration/' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { label: 'Guides', href: '/guides/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'FAQs', href: '/faq/' },
      { label: 'Official Links', href: '/official-links/' },
      { label: 'How It Works', href: '/how-it-works/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Trust', href: '/trust/' },
      { label: 'Start Assessment', href: '/contact/' },
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Disclaimer', href: '/disclaimer/' },
    ],
  },
];
---

<footer class="sk-footer">
  <div class="sk-wrap py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <a class="sk-logo" href="/">SK Immigration</a>
        <p class="mt-3 text-sm font-medium text-gold-light">{SITE.tagline}</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/65">
          Clear guidance for complex international processes. We prepare. Authorities decide.
        </p>
        <div class="mt-6 flex gap-2">
          {[
            { href: SOCIAL.facebook, label: 'Facebook', path: 'M24 12.073c0-6.627-5.373-12-12-12S0 5.446 0 12.073c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
            { href: SOCIAL.instagram, label: 'Instagram', path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849s-.012 3.584-.069 4.849c-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07s-3.584-.012-4.849-.07c-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849s.013-3.583.07-4.849c.149-3.227 1.664-4.771 4.919-4.919C8.416 2.175 8.796 2.163 12 2.163zm0 5.838a4.162 4.162 0 100 8.324 4.162 4.162 0 000-8.324zm6.406-1.845a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z' },
            { href: SOCIAL.linkedin, label: 'LinkedIn', path: 'M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5V5c0-2.761-2.238-5-5-5zM8 19H5V8h3v11zM6.5 6.732c-.966 0-1.75-.79-1.75-1.764S5.534 3.204 6.5 3.204s1.75.79 1.75 1.764-.784 1.764-1.75 1.764zM19 19h-3v-5.604c0-3.368-4-3.113-4 0V19h-3V8h3v1.765c1.396-2.586 7-2.777 7 2.476V19z' },
            { href: SOCIAL.youtube, label: 'YouTube', path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136C4.495 20.455 12 20.455 12 20.455s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z' },
          ].map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class="inline-flex h-9 w-9 items-center justify-center rounded-md hover:bg-white/10" aria-label={item.label}>
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d={item.path}></path></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((col) => (
          <div>
            <h2 class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-white/50">{col.title}</h2>
            <ul class="space-y-2 text-sm">
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-12 max-w-3xl text-xs leading-relaxed text-white/45">
      SK Immigration provides documentation, preparation and guidance services. Visa, immigration, university,
      company-registration and regulatory decisions are made by the relevant authorities. No outcome is guaranteed.
    </p>
    <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} SK Immigration. All rights reserved.</p>
      <p>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span class="mx-2">·</span>
        <a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneFormatted}</a>
      </p>
    </div>
  </div>
</footer>

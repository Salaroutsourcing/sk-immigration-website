---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="not-prose border-b border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-dark-950 md:py-16">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">{eyebrow}</p>
    <h1 class="mb-4 font-heading text-3xl font-bold text-slate-900 md:text-5xl dark:text-white">{title}</h1>
    <p class="text-lg text-slate-600 dark:text-slate-400">
      <slot />
    </p>
  </div>
</section>

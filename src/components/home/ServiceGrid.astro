---
import { SERVICE_CARDS, SERVICE_ACCENTS } from '../../data/services';
import ServiceIcon from '../services/ServiceIcon.astro';
---

<section class="home-section" aria-labelledby="home-services-heading">
  <div class="home-section__head reveal">
    <h2 id="home-services-heading">Services that match <span>a real goal</span></h2>
    <p>
      Each service is delivered remotely with a defined scope. We prepare and guide — we do not sell jobs, and we do
      not promise outcomes that authorities decide.
    </p>
  </div>
  <div class="home-svc-grid">
    {
      SERVICE_CARDS.map((service, index) => {
        const accent = SERVICE_ACCENTS[service.accent];
        const features = service.features.slice(0, 4);
        return (
          <article
            class="home-svc reveal"
            id={`home-${service.id}`}
            style={`--accent:${accent.hex};--accent-soft:${accent.soft};--accent-border:${accent.border};--float-delay:${index * 0.4}s`}
          >
            <div class="home-svc__blob" aria-hidden="true"></div>
            <div class="home-svc__icon">
              <ServiceIcon name={service.icon} class="h-5 w-5" />
            </div>
            <p class="home-svc__badge">{service.category}</p>
            <h3>{service.title}</h3>
            <p class="home-svc__desc">{service.description}</p>
            <ul>
              {features.map((item) => (
                <li>
                  <span class="svc-check" aria-hidden="true">
                    <ServiceIcon name="check" class="h-3 w-3" />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {service.notice && <p class="home-svc__notice">{service.notice}</p>}
            <a class="home-svc__cta" href={service.href}>
              {service.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        );
      })
    }
  </div>
  <a class="home-all-link" href="/services/">See the full Services experience →</a>
</section>

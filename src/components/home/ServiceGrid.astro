---
import { HOME_SERVICES } from '../../lib/home';
import ServiceCard from './ServiceCard.astro';

const services = HOME_SERVICES.filter((s) => s.id !== 'company');
---

<section class="section-container not-prose" id="services">
  <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
    <p class="eyebrow">Core services</p>
    <span class="accent-line mx-auto"></span>
    <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
      Support for the journey you're planning
    </h2>
    <p class="mt-3 text-base leading-[1.65] text-muted">
      Every service is delivered remotely with clear communication and a defined scope.
    </p>
  </div>
  <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((service) => (
      <ServiceCard service={service} />
    ))}
  </div>
</section>

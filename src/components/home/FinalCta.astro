---
import { ASSESSMENT_HREF, WHATSAPP_HREF } from '../../lib/home';
---

<section class="dest-convert" id="start" aria-labelledby="home-cta-heading">
  <div class="dest-convert__inner">
    <div class="dest-convert__brand">
      <img src="/assets/img/sk-logo.png" alt="" width="44" height="44" />
      <p>
        <strong id="home-cta-heading">Let’s start your journey</strong>
        <span>Registered in Rawalpindi. Free first assessment — written scope before any paid work.</span>
      </p>
    </div>
    <div class="dest-convert__actions">
      <a class="sk-btn sk-btn--primary" href={ASSESSMENT_HREF}>Start Assessment →</a>
      <a class="sk-btn sk-btn--ghost" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
    </div>
  </div>
</section>

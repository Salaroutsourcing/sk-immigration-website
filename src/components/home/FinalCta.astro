---
import { ASSESSMENT_HREF, SERVICES_HREF } from '../../lib/home';
---

<section class="not-prose" id="start">
  <div class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 md:pb-20">
    <div class="rounded-2xl bg-primary px-6 py-12 text-center text-white md:px-12 md:py-16">
      <p class="eyebrow text-gold-light">Next step</p>
      <span class="accent-line mx-auto mt-3 block"></span>
      <h2 class="font-heading mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Not sure what your next step should be?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-[1.65] text-white/75">
        Tell us what you're planning, where you're hoping to go, or what you're trying to build. We'll help you
        understand your options and the steps involved.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
        <a href={SERVICES_HREF} class="btn border-white/30 text-white hover:bg-white hover:text-primary">Explore Services</a>
      </div>
    </div>
  </div>
</section>

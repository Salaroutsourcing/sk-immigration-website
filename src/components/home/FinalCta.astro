---
import { ASSESSMENT_HREF, WHATSAPP_HREF } from '../../lib/home';
---

<section class="sk-section" id="start">
  <div class="sk-wrap">
    <div class="overflow-hidden rounded-2xl bg-navy px-6 py-14 text-center text-white md:px-16 md:py-16">
      <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">Start with your goal.</h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/70">
        Tell us what you’re planning. We’ll help you understand the options — without promising the outcome.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a class="btn-primary !bg-gold !border-gold !text-navy-dark hover:!bg-gold-light" href={ASSESSMENT_HREF}>Start My Assessment</a>
        <a class="btn-whatsapp" href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

---
import { TRUST_ITEMS } from '../../lib/home';
import TrustIcon from './TrustIcon.astro';
---

<section class="not-prose border-y border-gray-200 bg-slate-50/80 dark:border-slate-800 dark:bg-slate-900/40" aria-label="Trust signals">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 md:py-8">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {TRUST_ITEMS.map((item) => (
        <div class="flex gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white shadow-none ring-1 ring-gray-200 dark:bg-slate-900 dark:ring-slate-700">
            <TrustIcon name={item.icon} />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">{item.title}</p>
            <p class="text-sm text-muted dark:text-slate-400">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

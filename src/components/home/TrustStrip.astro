---
import { TRUST_ITEMS } from '../../lib/home';
import ServiceIcon from '../services/ServiceIcon.astro';

const icons = {
  globe: 'globe',
  document: 'document',
  fees: 'document',
  shield: 'shield',
  people: 'people',
} as const;
---

<section class="home-trust reveal" aria-label="Trust signals">
  <ul>
    {
      TRUST_ITEMS.map((item) => (
        <li>
          <span class="home-trust__icon">
            <ServiceIcon name={icons[item.icon]} class="h-[18px] w-[18px]" />
          </span>
          <span>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>

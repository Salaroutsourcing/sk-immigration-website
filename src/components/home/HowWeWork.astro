---
import { HOW_WE_WORK } from '../../lib/home';
---

<section class="not-prose" id="how-we-work">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
      <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Here's how we work.
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Clarity, honesty, preparation and communication — not pressure.
      </p>
    </div>
    <div class="mx-auto grid max-w-7xl gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {HOW_WE_WORK.map((item) => (
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-none dark:border-slate-800 dark:bg-slate-900">
          <p class="mb-2 text-sm font-bold text-slate-900 dark:text-white">
            <span class="mr-1 text-primary" aria-hidden="true">✓</span>
            {item.title}
          </p>
          <p class="text-sm leading-relaxed text-muted dark:text-slate-400">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

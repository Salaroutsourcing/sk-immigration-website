---
import { TRUST_CARDS } from '../../lib/home';
---

<section class="sk-section sk-section--canvas" id="why">
  <div class="sk-wrap">
    <div class="grid items-end gap-8 lg:grid-cols-[1fr_1.1fr]">
      <div class="sk-reveal">
        <p class="sk-eyebrow">Why SK Immigration</p>
        <h2 class="sk-h2">Built around clarity, not promises.</h2>
      </div>
      <p class="sk-lead sk-reveal">Know what’s included. Understand the process. Prepare properly — without false guarantees.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {TRUST_CARDS.map((card) => (
        <article class="sk-card sk-reveal">
          <span class="sk-card-n">{card.n}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

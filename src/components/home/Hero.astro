---
import DestinationStage from "./DestinationStage.astro";
---

<section class="dest-hero" aria-labelledby="home-hero-heading">
  <div class="dest-hero__inner">
    <div class="dest-hero__copy">
      <p class="dest-hero__eyebrow">
        <span class="dest-hero__eyebrow-dot" aria-hidden="true"></span>
        Registered immigration consultancy
      </p>
      <h1 id="home-hero-heading" class="dest-hero__title">
        Your Journey.<br />
        <span class="dest-hero__accent">Our Expertise.</span>
      </h1>
      <p class="dest-hero__lead">
        SK Immigration Services (SMC-Private) Limited is a Pakistan-registered consultancy. We
        prepare applications, explain requirements, and keep every fee in writing — decisions
        stay with the authorities.
      </p>

      <ul class="dest-hero__pills">
        <li>
          <span class="dest-hero__pill-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="1.7"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>
            <strong>Trusted &amp; registered</strong>
            <small>SECP CUIN 0304985</small>
          </span>
        </li>
        <li>
          <span class="dest-hero__pill-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </span>
          <span>
            <strong>Expert guidance</strong>
            <small>Official checklists, not shortcuts</small>
          </span>
        </li>
        <li>
          <span class="dest-hero__pill-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>
            <strong>Clear &amp; written</strong>
            <small>Fees before you pay</small>
          </span>
        </li>
        <li>
          <span class="dest-hero__pill-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M3 12h18M12 3c2.5 3 3.8 6 3.8 9S14.5 18 12 21c-2.5-3-3.8-6-3.8-9S9.5 6 12 3Z" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
          <span>
            <strong>Online from anywhere</strong>
            <small>WhatsApp, email, video</small>
          </span>
        </li>
      </ul>

      <div class="dest-hero__cta">
        <a class="sk-btn sk-btn--primary dest-hero__cta-primary" href="/services/">
          Explore Services
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="sk-btn sk-btn--ghost dest-hero__cta-ghost" href="/contact/">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 9h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Book a Consultation
        </a>
      </div>
    </div>

    <div class="dest-hero__stage">
      <DestinationStage />
    </div>
  </div>
</section>

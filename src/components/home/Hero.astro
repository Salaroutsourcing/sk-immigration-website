---
import { ASSESSMENT_HREF, SERVICES_HREF } from '../../lib/home';
import GlobalJourney from '../visuals/GlobalJourney.astro';
---

<section class="relative overflow-hidden sk-hero-fold">
  <div class="sk-wrap grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:py-20">
    <div>
      <p class="sk-eyebrow sk-reveal">Digital immigration & international business services</p>
      <h1 class="sk-h1 sk-reveal sk-reveal-delay-1">
        Your next chapter,<br />
        handled with <span class="sk-gold">clarity.</span>
      </h1>
      <p class="sk-lead mt-5 sk-reveal sk-reveal-delay-2">
        Visa preparation, education pathways, document services and international business support — explained clearly, prepared carefully and delivered online.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sk-reveal sk-reveal-delay-3">
        <a class="btn-primary" href={ASSESSMENT_HREF}>
          Start My Assessment
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a class="btn" href={SERVICES_HREF}>Explore Services</a>
      </div>
      <p class="mt-5 text-sm font-medium tracking-wide text-ink-soft sk-reveal">
        Clear scope · Transparent fees · No false guarantees
      </p>
    </div>
    <div class="sk-reveal sk-reveal-delay-2">
      <GlobalJourney />
    </div>
  </div>
</section>

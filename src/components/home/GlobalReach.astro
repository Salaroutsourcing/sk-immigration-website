---
import { REGIONAL_MARKETS, DIGITAL_POSITIONING } from '../../lib/regions';
---

<section class="not-prose" id="global">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary">Where we work</p>
      <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Digital everywhere. Local if you need a chair.
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">{DIGITAL_POSITIONING}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {REGIONAL_MARKETS.map((market) => (
        <a
          href={market.href}
          class="rounded-lg border border-gray-200 bg-white p-5 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-primary">
            {market.kind === 'head-office' ? 'Head office' : 'Appointment office'}
          </p>
          <h3 class="mt-2 font-heading text-lg font-bold text-slate-900 dark:text-white">{market.city}</h3>
          <p class="text-sm text-muted dark:text-slate-400">{market.country}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">{market.blurb}</p>
          <p class="mt-4 text-sm font-semibold text-primary">Open page →</p>
        </a>
      ))}
    </div>
  </div>
</section>

---
import { WHY_CHOOSE } from '../../lib/home';
---

<section class="not-prose bg-white dark:bg-dark-950" id="why">
  <div class="section-container">
    <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
      <p class="eyebrow">Why clients choose SK Immigration</p>
      <span class="accent-line mx-auto"></span>
      <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
        Clear, careful support — without the sales pitch
      </h2>
    </div>
    <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {WHY_CHOOSE.map((item) => (
        <article class="rounded-xl border border-line bg-page p-6 md:p-7 dark:border-slate-800 dark:bg-secondary">
          <p class="font-heading text-2xl font-bold text-accent">{item.n}</p>
          <h3 class="mt-3 font-heading text-lg font-bold text-ink dark:text-white">{item.title}</h3>
          <p class="mt-2 text-sm leading-[1.6] text-muted">{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

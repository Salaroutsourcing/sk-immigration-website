---
import { BUSINESS_HREF } from '../../lib/home';
import ServiceIcon from '../services/ServiceIcon.astro';
---

<section class="home-section reveal" id="company-formation" aria-labelledby="company-heading">
  <div class="company-band">
    <span class="company-band__icon" aria-hidden="true">
      <ServiceIcon name="building" class="h-6 w-6" />
    </span>
    <div>
      <p class="svc-eyebrow">International company registration</p>
      <h2 id="company-heading">Your ambitions don't have to stop at borders.</h2>
      <p>
        We provide remote guidance and documentation support for entrepreneurs planning to establish or expand
        internationally — United States, United Kingdom, Canada, Australia, and selected European jurisdictions.
      </p>
      <p class="company-band__notice">
        Company registration does not automatically provide immigration status, residency, a visa, a work permit or the
        right to operate in a particular country. Official authorities make those decisions.
      </p>
      <div class="company-band__ctas">
        <a href={BUSINESS_HREF} class="consult-cta__btn">Explore Company Registration →</a>
        <a href="/contact/" class="home-ghost">Start Business Assessment</a>
      </div>
    </div>
  </div>
</section>

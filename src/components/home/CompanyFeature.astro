---
import { ASSESSMENT_HREF, BUSINESS_HREF, COMPANY_DISCLAIMERS, COMPANY_EXTRA, COMPANY_MARKETS } from '../../lib/home';
---

<section class="not-prose" id="company-formation">
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 md:py-6">
    <div class="overflow-hidden rounded-2xl bg-primary text-white">
      <div class="grid items-center lg:grid-cols-12">
        <div class="p-8 md:p-12 lg:col-span-7">
          <p class="eyebrow text-gold-light">International company registration</p>
          <span class="accent-line mt-3 block"></span>
          <h2 class="font-heading mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Build across borders with clearer documentation support
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-[1.65] text-white/75">
            Starting a company in another country can feel complicated. Different jurisdictions, documents, registration
            procedures and compliance requirements can quickly become overwhelming.
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-[1.65] text-white/70">{COMPANY_EXTRA}</p>
          <p class="mt-5 text-sm font-medium text-gold-light">{COMPANY_MARKETS.join(' · ')}</p>
          <ul class="mt-5 max-w-2xl space-y-2 text-sm text-white/75">
            {COMPANY_DISCLAIMERS.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
            <a href={BUSINESS_HREF} class="btn border-white/30 text-white hover:bg-white hover:text-primary">
              Explore service
            </a>
          </div>
        </div>
        <div class="hidden items-center justify-center p-8 lg:col-span-5 lg:flex">
          <img
            src="/assets/hubs/company-registration.svg"
            alt=""
            class="h-48 w-48 rounded-xl bg-white/5 object-contain p-6"
            width="192"
            height="192"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

---
import { WHY_ITEMS } from '../../lib/home';
---

<section class="sk-section">
  <div class="sk-wrap grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <h2 class="sk-h2 max-w-md sk-reveal">Clear guidance<br />for complicated processes.</h2>
    <ol class="space-y-0 sk-reveal">
      {WHY_ITEMS.map((item) => (
        <li class="flex items-baseline gap-5 border-b border-line py-4 last:border-0">
          <span class="text-xs font-bold tracking-[0.14em] text-gold">{item.n}</span>
          <span class="text-lg font-bold tracking-tight text-navy md:text-xl">{item.title}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

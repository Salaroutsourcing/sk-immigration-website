---
import { HONESTY_NO, HONESTY_YES } from '../../lib/home';
---

<section class="sk-honesty sk-section" id="honesty">
  <div class="sk-wrap">
    <div class="max-w-3xl sk-reveal">
      <h2>We don’t promise the outcome.<br />We prepare you for the process.</h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-white/65">
        Visa, immigration, university and regulatory decisions remain with the relevant authorities.
      </p>
    </div>
    <div class="sk-honesty-grid">
      <div class="sk-honesty-list sk-honesty-list--no">
        {HONESTY_NO.map((item) => <span>{item}</span>)}
      </div>
      <div class="sk-honesty-list sk-honesty-list--yes">
        {HONESTY_YES.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>
</section>

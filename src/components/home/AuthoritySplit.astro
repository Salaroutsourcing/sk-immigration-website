---
import { WE_HANDLE, AUTHORITIES_DECIDE } from '../../lib/home';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class:list={['not-prose', compact ? 'py-6' : 'section-container']} id={compact ? undefined : 'roles'}>
  <div class:list={['text-center', compact ? 'mb-6 max-w-2xl' : 'mb-10 md:mx-auto md:mb-12 max-w-3xl', compact ? '' : 'md:mx-auto']}>
    {!compact && <p class="eyebrow">Roles</p>}
    {!compact && <span class="accent-line mx-auto"></span>}
    <h2 class:list={['font-heading font-bold tracking-tight text-ink dark:text-white', compact ? 'mb-2 text-2xl' : 'mt-3 mb-3 text-3xl sm:text-4xl']}>
      What we handle — and what authorities decide
    </h2>
    <p class:list={['text-muted', compact ? 'text-sm' : 'text-base leading-[1.65]']}>
      We'll be clear about our role. You shouldn't have to guess where our work ends.
    </p>
  </div>
  <div class:list={['grid gap-5 md:grid-cols-2', compact ? '' : 'mx-auto max-w-5xl']}>
    <div class="rounded-xl border border-line bg-white p-6 md:p-8 dark:border-slate-800 dark:bg-slate-900">
      <h3 class="mb-5 font-heading text-lg font-bold text-ink dark:text-white">What we handle</h3>
      <ul class="space-y-3">
        {WE_HANDLE.map((item) => (
          <li class="flex items-start gap-3 text-sm text-ink dark:text-slate-200">
            <span class="mt-0.5 text-accent" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-xl border border-line bg-page p-6 md:p-8 dark:border-slate-800 dark:bg-secondary">
      <h3 class="mb-5 font-heading text-lg font-bold text-ink dark:text-white">What authorities decide</h3>
      <ul class="space-y-3">
        {AUTHORITIES_DECIDE.map((item) => (
          <li class="flex items-start gap-3 text-sm text-ink dark:text-slate-200">
            <span class="mt-0.5 text-muted" aria-hidden="true">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

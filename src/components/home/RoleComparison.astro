---
import { AUTHORITIES_DECIDE, WE_HANDLE } from '../../lib/home';
---

<section class="sk-section" id="roles">
  <div class="sk-wrap">
    <div class="mx-auto max-w-2xl text-center sk-reveal">
      <h2 class="sk-h2">What we handle. What authorities decide.</h2>
      <p class="sk-lead mx-auto mt-4">Professional role clarity — not a legal warning.</p>
    </div>
    <div class="sk-compare mt-10 sk-reveal">
      <article>
        <h3>We handle</h3>
        <ul>
          {WE_HANDLE.map((item) => (
            <li><span class="sk-dot"></span>{item}</li>
          ))}
        </ul>
      </article>
      <article>
        <h3>Authorities decide</h3>
        <ul>
          {AUTHORITIES_DECIDE.map((item) => (
            <li><span class="sk-dot sk-dot--muted"></span>{item}</li>
          ))}
        </ul>
      </article>
    </div>
    <p class="mt-8 text-center text-lg font-bold tracking-tight text-navy">We prepare. We guide. Authorities decide.</p>
  </div>
</section>

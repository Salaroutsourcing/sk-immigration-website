---
import { PATHWAYS } from '../../lib/home';
import { SERVICE_ACCENTS } from '../../data/services';
import ServiceIcon from '../services/ServiceIcon.astro';

const meta = [
  { icon: 'graduation' as const, accent: 'blue' as const },
  { icon: 'passport' as const, accent: 'purple' as const },
  { icon: 'briefcase' as const, accent: 'teal' as const },
  { icon: 'building' as const, accent: 'indigo' as const },
];
---

<section class="home-section reveal" id="pathways" aria-labelledby="pathways-heading">
  <div class="home-section__head">
    <h2 id="pathways-heading">What are you <span>planning?</span></h2>
    <p>You don't need to know the perfect pathway before you contact us. Start with the goal that feels closest.</p>
  </div>
  <div class="path-grid">
    {
      PATHWAYS.map((item, i) => {
        const accent = SERVICE_ACCENTS[meta[i].accent];
        return (
          <a
            class="path-card"
            href={item.href}
            style={`--accent:${accent.hex};--accent-soft:${accent.soft};--accent-border:${accent.border}`}
          >
            <span class="path-card__icon">
              <ServiceIcon name={meta[i].icon} class="h-5 w-5" />
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="path-card__cta">{item.cta} →</span>
          </a>
        );
      })
    }
  </div>
</section>

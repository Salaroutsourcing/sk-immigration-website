---
import { PATHWAYS } from '../../lib/home';
---

<section class="section-container not-prose" id="pathways">
  <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
    <p class="eyebrow">What are you planning?</p>
    <span class="accent-line mx-auto"></span>
    <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
      Choose the direction that matches your goal
    </h2>
    <p class="mt-3 text-base leading-[1.65] text-muted">
      You don't need to know the perfect pathway before you contact us.
    </p>
  </div>
  <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {PATHWAYS.map((item) => (
      <a href={item.href} class="card-premium group block">
        <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg border border-accent/30 bg-accent/10">
          <img src={item.image} alt="" class="h-7 w-7 object-contain" width="28" height="28" loading="lazy" />
        </div>
        <h3 class="mb-2 font-heading text-lg font-bold text-ink dark:text-white">{item.title}</h3>
        <p class="mb-4 text-sm leading-[1.6] text-muted">{item.description}</p>
        <span class="text-sm font-semibold text-primary group-hover:text-accent">{item.cta} →</span>
      </a>
    ))}
  </div>
</section>

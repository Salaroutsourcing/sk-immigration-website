---
import { PATHWAYS } from '../../lib/home';
---

<section class="section-container not-prose" id="pathways">
  <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
    <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      What are you planning?
    </h2>
    <p class="text-xl text-muted dark:text-slate-400">
      You don't need to know the perfect pathway before you contact us.
    </p>
  </div>
  <div class="mx-auto grid max-w-7xl gap-6 sm:grid-cols-2">
    {PATHWAYS.map((item) => (
      <a
        href={item.href}
        class="group rounded-lg border border-gray-200 bg-white p-6 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
      >
        <div class="mb-4 flex items-center gap-4">
          <img src={item.image} alt="" class="h-12 w-12 rounded-md object-cover" width="48" height="48" loading="lazy" />
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">{item.title}</h3>
        </div>
        <p class="mb-4 text-muted text-sm leading-relaxed dark:text-slate-400">{item.description}</p>
        <span class="text-sm font-semibold text-primary group-hover:underline">{item.cta} →</span>
      </a>
    ))}
  </div>
</section>

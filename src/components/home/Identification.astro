---
import { HOME_GATEWAYS } from '../../lib/home';
import { SERVICE_ACCENTS } from '../../data/services';
import ServiceIcon from '../services/ServiceIcon.astro';
---

<section class="dest-gateways reveal" id="pathways" aria-labelledby="gateways-heading">
  <div class="dest-gateways__head">
    <h2 id="gateways-heading">Where should we <span>start?</span></h2>
    <p>
      Study, visit, Ausbildung, attestation or a company — you do not need the perfect pathway
      first. Five doors into the work; the full catalog lives on Services.
    </p>
  </div>
  <div class="dest-gate-grid">
    {
      HOME_GATEWAYS.map((item) => {
        const accent = SERVICE_ACCENTS[item.accent];
        return (
          <a
            class="dest-gate"
            href={item.href}
            style={`--accent:${accent.hex};--accent-soft:${accent.soft};--accent-border:${accent.border}`}
          >
            <span class="dest-gate__icon">
              <ServiceIcon name={item.icon} class="h-5 w-5" />
            </span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="dest-gate__cta">
              {item.cta}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
          </a>
        );
      })
    }
  </div>
  <p class="dest-gateways__more">
    <a href="/services/">See all services in detail →</a>
  </p>
</section>

---
import { PROCESS_STEPS } from '../../lib/home';
---

<section class="home-section reveal" id="how-it-works" aria-labelledby="process-heading">
  <div class="home-section__head">
    <h2 id="process-heading">A clearer process, from the first conversation to the <span>next step</span></h2>
    <p>Five steps. Written scope before you pay. Government, embassy, university and regulatory decisions stay outside our control.</p>
  </div>
  <ol class="home-steps">
    {
      PROCESS_STEPS.map((step) => (
        <li class="home-step">
          <span class="home-step__n">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="home-steps-note">You stay informed throughout the agreed service. Authorities decide the outcome.</p>
</section>

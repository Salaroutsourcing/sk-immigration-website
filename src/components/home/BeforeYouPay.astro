---
import { BEFORE_YOU_PAY } from '../../lib/home';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<section class:list={['not-prose', embedded ? '' : '']} id={embedded ? undefined : 'before-you-pay'}>
  <div class:list={[embedded ? '' : 'mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16']}>
    <div class:list={['rounded-xl border border-line bg-white dark:border-slate-800 dark:bg-slate-900', embedded ? 'p-5 md:p-7' : 'mx-auto max-w-5xl p-6 md:p-10']}>
      <h2 class:list={['font-heading text-center font-bold tracking-tight text-slate-900 dark:text-white', embedded ? 'mb-6 text-2xl' : 'mb-8 text-3xl sm:text-4xl']}>
        Before you pay, you should know:
      </h2>
      <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {BEFORE_YOU_PAY.map((item) => (
          <div>
            <dt class="mb-1 text-sm font-bold text-slate-900 dark:text-white">{item.q}</dt>
            <dd class="text-sm leading-relaxed text-muted dark:text-slate-400">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

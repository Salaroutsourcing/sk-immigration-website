---
import { BEFORE_YOU_PAY } from '../../lib/home';
---

<section class="not-prose" id="before-you-pay">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <div class="mx-auto max-w-5xl rounded-lg border border-gray-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900 md:p-10">
      <h2 class="font-heading mb-8 text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Before you pay, you should know:
      </h2>
      <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {BEFORE_YOU_PAY.map((item) => (
          <div>
            <dt class="mb-1 text-sm font-bold text-slate-900 dark:text-white">{item.q}</dt>
            <dd class="text-sm leading-relaxed text-muted dark:text-slate-400">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

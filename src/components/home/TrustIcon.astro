---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
  {name === 'globe' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3c2.5 2.4 3.75 5.4 3.75 9S14.5 18.6 12 21C9.5 18.6 8.25 15.6 8.25 12S9.5 5.4 12 3z" />
  )}
  {name === 'document' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M7 3.75h6.75L18 8v12.25H7A1.25 1.25 0 015.75 19V5A1.25 1.25 0 017 3.75zM13.5 3.75V8H18M8.5 12h7M8.5 15.5h7M8.5 19h4.5" />
  )}
  {name === 'fees' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12M15.5 9.25c0-1.4-1.57-2.5-3.5-2.5s-3.5 1.1-3.5 2.5 1.57 2.5 3.5 2.5 3.5 1.1 3.5 2.5-1.57 2.5-3.5 2.5-3.5-1.1-3.5-2.5" />
  )}
  {name === 'shield' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3.5l7 3v5.2c0 4.1-2.7 7.7-7 9.3-4.3-1.6-7-5.2-7-9.3V6.5l7-3z" />
  )}
  {name === 'people' && (
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 7.5a2.75 2.75 0 11-5.5 0 2.75 2.75 0 015.5 0zM6.75 9a2 2 0 11-4 0 2 2 0 014 0zM13 13.75c-2.8 0-5.25 1.45-5.25 3.25V18.5h10.5v-1.5c0-1.8-2.45-3.25-5.25-3.25zM4.5 14.25c-1.7.35-3 1.3-3 2.5V18.5h2.5" />
  )}
</svg>

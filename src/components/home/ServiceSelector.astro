---
import { PLANNING_CARDS } from '../../lib/home';

const icons: Record<string, string> = {
  study: 'M4 10l8-5 8 5-8 5-8-5zm0 4l8 5 8-5',
  visit: 'M3 11h18M5 6h14v12H5z',
  work: 'M4 8h16v11H4V8zm4-3h8v3H8V5z',
  docs: 'M7 3h8l4 4v14H7V3z',
  business: 'M4 20V8l8-5 8 5v12H4z',
};
---

<section class="sk-section" id="planning">
  <div class="sk-wrap">
    <div class="max-w-xl sk-reveal">
      <h2 class="sk-h2">What are you planning?</h2>
      <p class="sk-lead mt-4">Start with your goal. We’ll help you understand the next step.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {PLANNING_CARDS.map((card, i) => (
        <a class:list={['sk-card sk-reveal', i === 1 && 'sk-reveal-delay-1', i === 2 && 'sk-reveal-delay-2']} href={card.href}>
          <span class="sk-card-n">{card.n}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <div class="sk-card-foot">
            <span class="sk-card-icon">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d={icons[card.icon]}></path></svg>
            </span>
            <span class="sk-card-arrow" aria-hidden="true">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

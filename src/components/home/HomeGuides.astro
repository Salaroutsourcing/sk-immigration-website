---
import { publishedBlogs } from '../../lib/content';
import { coverImageFor, readingMinutesFromText, topicLabel } from '../../lib/article';

const items = (await publishedBlogs()).slice(0, 3);
---

{items.length > 0 && (
  <section class="not-prose bg-white dark:bg-dark-950" id="guides">
    <div class="section-container">
      <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
        <p class="eyebrow">Guides &amp; resources</p>
        <span class="accent-line mx-auto"></span>
        <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
          Practical reading before you decide
        </h2>
      </div>
      <div class="mx-auto grid max-w-7xl gap-5 md:grid-cols-3">
        {items.map((entry) => (
          <article class="card-premium flex h-full flex-col overflow-hidden p-0">
            <a href={`/blog/${entry.id}/`} class="block overflow-hidden">
              <img
                src={coverImageFor({ image: entry.data.heroImage, cluster: 'blog', category: entry.data.category })}
                alt=""
                class="aspect-[16/10] w-full object-cover"
                width="640"
                height="400"
                loading="lazy"
              />
            </a>
            <div class="flex flex-1 flex-col p-6">
              <p class="eyebrow">{topicLabel(entry.data.category)}</p>
              <h3 class="mt-2 font-heading text-lg font-bold text-ink dark:text-white">
                <a href={`/blog/${entry.id}/`} class="hover:text-primary">{entry.data.title}</a>
              </h3>
              <p class="mt-2 line-clamp-3 flex-1 text-sm leading-[1.6] text-muted">{entry.data.description}</p>
              <p class="mt-4 text-xs text-muted">{readingMinutesFromText(entry.body)} min read</p>
              <a href={`/blog/${entry.id}/`} class="mt-3 text-sm font-semibold text-primary">Read guide →</a>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href="/guides/" class="text-sm font-semibold text-primary hover:text-accent">Explore all guides →</a>
      </p>
    </div>
  </section>
)}

---
import { NEVER_PROMISE, WE_PROMISE } from '../../lib/home';
---

<section class="home-section reveal" id="honesty" aria-labelledby="honesty-heading">
  <div class="home-section__head">
    <h2 id="honesty-heading">Because your future deserves more than a <span>sales pitch</span></h2>
    <p>Your trust is more valuable than a sale. We will never tell you something is guaranteed when it isn’t.</p>
  </div>
  <div class="honesty-grid">
    <div class="honesty-col">
      <h3>We will never promise</h3>
      <ul>
        {
          NEVER_PROMISE.map((item) => (
            <li>
              <span class="honesty-x" aria-hidden="true">✕</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="honesty-col">
      <h3>What we do promise</h3>
      <ul>
        {
          WE_PROMISE.map((item) => (
            <li>
              <span class="clarity-tick" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="honesty-foot">Honest guidance. Clear processes. Completely online.</p>
</section>

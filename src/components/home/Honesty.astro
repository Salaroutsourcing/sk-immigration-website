---
import { NEVER_PROMISE, WE_PROMISE } from '../../lib/home';
---

<section class="not-prose bg-primary text-white" id="honesty">
  <div class="section-container">
    <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
      <p class="eyebrow text-gold-light">No false promises</p>
      <span class="accent-line mx-auto"></span>
      <h2 class="font-heading mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        We don't sell guarantees.<br />We provide preparation, guidance and clarity.
      </h2>
    </div>
    <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-2">
      <div class="rounded-xl border border-white/10 bg-white/5 p-6 md:p-8">
        <h3 class="mb-5 font-heading text-lg font-bold text-white">We never promise</h3>
        <ul class="space-y-3">
          {NEVER_PROMISE.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/80">
              <span class="mt-0.5 font-bold text-gold-light" aria-hidden="true">✕</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl border border-accent/40 bg-white/5 p-6 md:p-8">
        <h3 class="mb-5 font-heading text-lg font-bold text-white">We do provide</h3>
        <ul class="space-y-3">
          {WE_PROMISE.map((item) => (
            <li class="flex items-start gap-3 text-sm text-white/80">
              <span class="mt-0.5 text-accent" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

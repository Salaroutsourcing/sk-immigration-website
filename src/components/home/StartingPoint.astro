---
import { FINDER_HREF } from '../../lib/home';
---

<section class="not-prose" id="starting-point">
  <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 md:pb-16">
    <div class="mx-auto max-w-3xl rounded-lg border border-gray-200 bg-white px-6 py-10 text-center shadow-none dark:border-slate-800 dark:bg-slate-900">
      <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Not sure where to start?</h2>
      <p class="mx-auto mb-6 max-w-xl text-muted dark:text-slate-400">
        Answer a few questions and find the SK Immigration service or guide most relevant to your goal.
      </p>
      <a href={FINDER_HREF} class="btn">Find My Starting Point</a>
    </div>
  </div>
</section>

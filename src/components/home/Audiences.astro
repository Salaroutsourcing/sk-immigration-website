---
import { AUDIENCES } from '../../lib/home';
---

<section class="section-container not-prose" id="who-we-help">
  <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
    <p class="eyebrow">Who we help</p>
    <span class="accent-line mx-auto"></span>
    <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
      Built for people planning their next chapter
    </h2>
  </div>
  <div class="mx-auto grid max-w-7xl gap-5 sm:grid-cols-2 lg:grid-cols-5">
    {AUDIENCES.map((item) => (
      <div class="rounded-xl border border-line bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="mb-2 font-heading text-base font-bold text-ink dark:text-white">{item.title}</h3>
        <p class="text-sm leading-[1.6] text-muted">{item.text}</p>
      </div>
    ))}
  </div>
</section>

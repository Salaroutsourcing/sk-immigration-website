---
import { HOME_SERVICES } from '../../lib/home';

interface Props {
  service: (typeof HOME_SERVICES)[number];
}

const { service } = Astro.props;
---

<article class="card-premium group flex h-full flex-col" id={service.id}>
  <div class="mb-4 flex items-start justify-between gap-3">
    <div class="flex h-11 w-11 items-center justify-center rounded-lg border border-accent/30 bg-accent/10">
      <img src={service.image} alt="" class="h-7 w-7 object-contain" width="28" height="28" loading="lazy" />
    </div>
    <p class="eyebrow text-right">{service.category}</p>
  </div>
  <h3 class="mb-2 font-heading text-lg font-bold text-ink dark:text-white">{service.title}</h3>
  {'badge' in service && service.badge && (
    <p class="mb-2 text-xs font-semibold text-primary">{service.badge}</p>
  )}
  <p class="mb-4 text-sm leading-[1.6] text-muted">{service.description}</p>
  {'notice' in service && service.notice && (
    <p class="mb-4 rounded-lg border border-line bg-page px-3 py-2 text-xs leading-relaxed text-ink dark:border-slate-700 dark:bg-secondary dark:text-slate-200">
      {service.notice}
    </p>
  )}
  {'destinations' in service && service.destinations && (
    <p class="mb-3 text-xs font-medium text-primary">{service.destinations.join(' · ')}</p>
  )}
  <ul class="mb-5 flex-1 space-y-2 text-sm text-ink dark:text-slate-200">
    {service.benefits.slice(0, 5).map((item) => (
      <li class="flex items-start gap-2">
        <span class="mt-0.5 text-accent" aria-hidden="true">✓</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
  {'note' in service && service.note && <p class="mb-3 text-xs italic text-muted">{service.note}</p>}
  {'jobsDisclaimer' in service && service.jobsDisclaimer && (
    <p class="mb-4 text-xs font-semibold text-ink dark:text-slate-200">{service.jobsDisclaimer}</p>
  )}
  <a href={service.href} class="mt-auto text-sm font-semibold text-primary transition group-hover:text-accent">
    Explore service →
  </a>
</article>

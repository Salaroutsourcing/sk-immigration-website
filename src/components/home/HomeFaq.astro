---
import { HOME_FAQS } from '../../lib/home';
import FaqAccordion from '../ui/FaqAccordion.astro';
---

<section class="sk-section" id="faq">
  <div class="sk-wrap grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="sk-reveal">
      <p class="sk-eyebrow">FAQ</p>
      <h2 class="sk-h2">Clear answers.</h2>
      <p class="sk-lead mt-4">If it isn’t listed here, start an assessment and ask.</p>
      <a class="btn mt-8" href="/faq/">Read all FAQs</a>
    </div>
    <div class="sk-reveal">
      <FaqAccordion faqs={HOME_FAQS} />
    </div>
  </div>
</section>

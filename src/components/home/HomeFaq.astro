---
import { HOME_FAQS } from '../../lib/home';
---

<section class="section-container not-prose" id="faq">
  <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
    <p class="eyebrow">FAQ</p>
    <span class="accent-line mx-auto"></span>
    <h2 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-white">
      Questions people ask before they write to us
    </h2>
  </div>
  <div class="mx-auto max-w-3xl divide-y divide-line dark:divide-slate-800">
    {HOME_FAQS.map((faq) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink dark:text-slate-200">
          <span>{faq.q}</span>
          <span class="text-accent transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-2 max-w-2xl text-sm leading-[1.65] text-muted">{faq.a}</p>
      </details>
    ))}
  </div>
  <p class="mt-8 text-center text-sm">
    <a href="/faq/" class="font-semibold text-primary hover:text-accent">Read all FAQs →</a>
  </p>
</section>

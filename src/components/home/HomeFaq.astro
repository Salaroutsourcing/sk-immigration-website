---
import { HOME_FAQS } from '../../lib/home';

const items = HOME_FAQS.slice(0, 6);
---

<section class="home-section reveal" id="faq" aria-labelledby="home-faq-heading">
  <div class="home-section__head">
    <h2 id="home-faq-heading">Questions people ask before they <span>write to us</span></h2>
    <p>Here's what you should know. We'll explain the rest in a conversation — without pressure.</p>
  </div>
  <div class="home-faq">
    {
      items.map((faq) => (
        <details>
          <summary>
            <span>{faq.q}</span>
            <span aria-hidden="true">+</span>
          </summary>
          <p>{faq.a}</p>
        </details>
      ))
    }
  </div>
  <a class="home-all-link" href="/faq/">Read all FAQs →</a>
</section>

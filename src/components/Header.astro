---
import { SITE, NAVIGATION, CONTACT } from '../lib/config';
import { ASSESSMENT_HREF } from '../lib/home';

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="sticky top-0 z-40 w-full" id="header">
  <div class="relative mx-auto flex h-[72px] max-w-7xl items-center justify-between gap-4 px-4 md:h-[76px] md:px-6">
    <a class="flex min-w-0 items-center gap-2.5" href="/">
      <img
        src={SITE.logo}
        alt=""
        class="h-9 w-9 rounded-md object-cover"
        width="36"
        height="36"
        loading="eager"
      />
      <span class="truncate font-heading text-base font-bold text-ink md:text-[1.05rem] dark:text-white">
        SK Immigration
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Main navigation">
      <ul class="flex items-center gap-1">
        {NAVIGATION.map((item) => (
          <li>
            <a
              class:list={[
                'relative px-3 py-2 text-sm font-medium transition duration-200',
                isActive(item.href)
                  ? 'text-ink after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:bg-accent dark:text-white'
                  : 'text-muted hover:text-ink dark:hover:text-white',
              ]}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={CONTACT.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 text-sm font-medium text-muted transition hover:text-ink md:inline-flex dark:hover:text-white"
      >
        <svg class="h-4 w-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 6.165L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
      <a href={ASSESSMENT_HREF} class="btn-primary px-3 py-2 text-xs sm:px-4 sm:text-sm">
        Start Assessment
      </a>
      <button
        type="button"
        class="theme-toggle hidden rounded-md p-2 text-muted hover:bg-page hover:text-ink lg:inline-flex dark:hover:bg-secondary"
        aria-label="Toggle dark mode"
      >
        <svg class="sun-icon hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <svg class="moon-icon h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="inline-flex items-center rounded-md p-2 text-ink lg:hidden dark:text-white"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        id="mobile-menu-btn"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-drawer" class="fixed inset-0 z-50 hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <button type="button" class="absolute inset-0 bg-primary/40" id="drawer-backdrop" aria-label="Close menu"></button>
  <div class="absolute inset-y-0 right-0 flex w-[min(100%,20.5rem)] flex-col bg-white shadow-xl dark:bg-primary">
    <div class="flex items-center justify-between border-b border-line px-5 py-4 dark:border-white/10">
      <p class="font-heading text-sm font-bold text-ink dark:text-white">Menu</p>
      <button type="button" class="rounded-md p-2 text-muted hover:text-ink" id="drawer-close" aria-label="Close menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Mobile">
      <ul class="space-y-1">
        {NAVIGATION.map((item) => (
          <li>
            <a
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium',
                isActive(item.href) ? 'bg-page text-ink dark:bg-secondary dark:text-white' : 'text-muted hover:bg-page hover:text-ink dark:hover:bg-secondary dark:hover:text-white',
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="space-y-3 border-t border-line p-5 dark:border-white/10">
      <a href={ASSESSMENT_HREF} class="btn-primary w-full">Start My Assessment</a>
      <a
        href={CONTACT.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn w-full"
      >
        WhatsApp
      </a>
      <button
        type="button"
        class="theme-toggle w-full rounded-lg px-3 py-2 text-sm text-muted hover:bg-page dark:hover:bg-secondary"
        aria-label="Toggle dark mode"
      >
        Toggle appearance
      </button>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById('header');
  const themeToggles = document.querySelectorAll('.theme-toggle');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const drawerClose = document.getElementById('drawer-close');
  const drawerBackdrop = document.getElementById('drawer-backdrop');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.sun-icon').forEach((el) => el.classList.toggle('hidden', !isDark));
    document.querySelectorAll('.moon-icon').forEach((el) => el.classList.toggle('hidden', isDark));
  }

  function onScroll() {
    header?.classList.toggle('scroll', window.scrollY > 8);
  }

  function setDrawer(open: boolean) {
    drawer?.classList.toggle('hidden', !open);
    header?.classList.toggle('expanded', open);
    menuBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.classList.toggle('overflow-hidden', open);
  }

  updateThemeUI();
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  themeToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI();
    });
  });

  menuBtn?.addEventListener('click', () => setDrawer(drawer?.classList.contains('hidden') === true));
  drawerClose?.addEventListener('click', () => setDrawer(false));
  drawerBackdrop?.addEventListener('click', () => setDrawer(false));
  drawer?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setDrawer(false)));
</script>

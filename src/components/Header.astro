---
import { SITE, CONTACT } from '../lib/config';
import { ASSESSMENT_HREF } from '../lib/home';
import { GUIDES_MENU, HEADER_LINKS, SERVICES_MENU } from '../lib/nav';

const menus = {
  services: SERVICES_MENU,
  guides: GUIDES_MENU,
};
---

<header class="sk-header" id="header">
  <div class="sk-header-bar">
    <div class="sk-header-inner">
      <a class="sk-logo" href="/">
        <img src={SITE.logo} alt="" width="32" height="32" />
        <span>SK Immigration</span>
      </a>

      <nav class="sk-nav" aria-label="Main navigation">
        {HEADER_LINKS.map((item) =>
          'menu' in item && item.menu ? (
            <div class="sk-nav-item">
              <button
                class="sk-nav-trigger"
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="sk-nav-caret" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                </svg>
              </button>
              <div class:list={['sk-mega', item.menu === 'guides' && 'sk-mega--guides']}>
                <div class:list={[item.menu === 'services' ? 'sk-mega-grid' : 'grid gap-0.5']}>
                  {menus[item.menu].map((entry) => (
                    <a href={entry.href}>
                      <strong>{entry.label}</strong>
                      <span>{entry.text}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a class="sk-nav-link" href={item.href}>{item.label}</a>
          )
        )}
      </nav>

      <div class="sk-header-actions">
        <a
          class="btn-whatsapp"
          href={CONTACT.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>
        <a class="btn-primary" href={ASSESSMENT_HREF}>Start Assessment</a>
      </div>

      <div class="sk-header-mobile">
        <a class="btn-primary whitespace-nowrap px-2.5 py-2 text-[0.7rem] leading-none" href={ASSESSMENT_HREF}>Start Assessment</a>
        <button class="sk-icon-btn" type="button" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="sk-drawer" id="sk-drawer" hidden={false}>
  <div class="sk-drawer-backdrop"></div>
  <div class="sk-drawer-panel" role="dialog" aria-label="Menu">
    <div class="sk-drawer-head">
      <a class="sk-logo" href="/">
        <img src={SITE.logo} alt="" width="32" height="32" />
        <span>SK Immigration</span>
      </a>
      <button class="sk-icon-btn" type="button" id="sk-drawer-close" aria-label="Close menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <nav>
      <details open>
        <summary>Services</summary>
        {SERVICES_MENU.map((entry) => <a href={entry.href}>{entry.label}</a>)}
      </details>
      <a href="/how-it-works/">How It Works</a>
      <details>
        <summary>Guides</summary>
        {GUIDES_MENU.map((entry) => <a href={entry.href}>{entry.label}</a>)}
      </details>
      <a href="/about/">About</a>
      <a href="/faq/">FAQs</a>
      <a href="/contact/">Start Assessment</a>
    </nav>
    <div class="sk-drawer-actions">
      <a class="btn-primary" href={ASSESSMENT_HREF}>Start Assessment</a>
      <a class="btn-whatsapp" href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      <button class="theme-toggle btn" type="button" aria-label="Toggle dark mode">
        <svg class="sun-icon hidden h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <svg class="moon-icon h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        <span>Appearance</span>
      </button>
    </div>
  </div>
</div>

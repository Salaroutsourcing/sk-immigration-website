---
import { SITE, NAVIGATION } from '../lib/config';
---

<header
  class="sticky top-0 z-40 w-full border-b border-slate-100 bg-white/90 backdrop-blur-md dark:border-slate-800 dark:bg-dark-950/90"
  id="header"
>
  <div class="relative mx-auto flex max-w-7xl flex-col px-3 py-3.5 md:flex-row md:items-center md:justify-between md:px-6">
    <div class="flex items-center justify-between">
      <a class="flex items-center gap-3 text-lg font-bold text-slate-900 md:text-xl dark:text-white" href="/">
        <img
          src={SITE.logo}
          alt="SK Immigration Services logo"
          class="h-10 w-10 rounded-lg object-cover"
          width="40"
          height="40"
          loading="eager"
        />
        <span class="flex flex-col">
          <span class="font-heading leading-tight tracking-tight">SK Immigration</span>
          <span class="text-[10px] font-medium tracking-normal text-slate-500 dark:text-slate-400">
            SECP CUIN 0304985
          </span>
        </span>
      </a>
      <button
        type="button"
        class="inline-flex items-center rounded-lg p-2.5 text-slate-500 md:hidden dark:text-slate-400"
        aria-label="Toggle menu"
        aria-expanded="false"
        id="mobile-menu-btn"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <nav
      class="mt-4 hidden w-full items-center overflow-y-auto text-slate-600 md:mt-0 md:flex md:h-auto md:w-auto dark:text-slate-200"
      aria-label="Main navigation"
      id="navigation-menu"
    >
      <ul class="flex w-full flex-col font-medium md:flex-row md:items-center md:text-[0.9375rem]">
        {NAVIGATION.map((item) => (
          <li>
            <a
              class="flex items-center px-4 py-3 transition hover:text-primary-600 dark:hover:text-primary-400"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <button
        type="button"
        class="inline-flex items-center rounded-lg p-2.5 text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
        aria-label="Toggle dark mode"
        id="theme-toggle"
      >
        <svg id="sun-icon" class="hidden h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <svg id="moon-icon" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>
      <a href="/contact/" class="btn-primary px-5 py-2 text-sm shadow-none">Free Consultation</a>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const navMenu = document.getElementById('navigation-menu');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', !isDark);
    moonIcon?.classList.toggle('hidden', isDark);
  }

  updateThemeUI();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeUI();
  });

  menuBtn?.addEventListener('click', () => {
    const open = navMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

---
import { SITE, NAVIGATION, CONTACT } from '../lib/config';
import { ASSESSMENT_HREF } from '../lib/home';
---

<header
  class="sticky top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out"
  id="header"
>
  <div class="absolute inset-0"></div>
  <div class="relative text-default mx-auto w-full max-w-7xl px-3 py-3 md:flex md:justify-between md:px-6">
    <div class="flex justify-between">
      <a class="flex items-center" href="/">
        <span class="flex items-center gap-2 whitespace-nowrap text-2xl font-bold text-gray-900 md:text-xl dark:text-white">
          <img
            src={SITE.logo}
            alt=""
            class="h-9 w-9 rounded-md object-cover"
            width="36"
            height="36"
            loading="eager"
          />
          <span>SK Immigration</span>
        </span>
      </a>
      <div class="flex items-center gap-1 md:hidden">
        <a
          href={CONTACT.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp px-3 py-2 text-xs font-semibold"
        >
          WhatsApp
        </a>
        <button
          type="button"
          class="theme-toggle inline-flex items-center rounded-lg p-2.5 text-sm text-muted hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-800 dark:focus:ring-gray-700"
          aria-label="Toggle dark mode"
        >
          <svg class="sun-icon hidden h-6 w-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
          <svg class="moon-icon h-6 w-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
        </button>
        <button
          type="button"
          class="inline-flex items-center rounded-lg p-2.5 text-sm text-muted hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-800 dark:focus:ring-gray-700"
          aria-label="Toggle menu"
          aria-expanded="false"
          id="mobile-menu-btn"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav
      class="hidden w-full items-center overflow-y-auto overflow-x-hidden text-default md:mx-5 md:flex md:w-auto md:overflow-x-auto md:overflow-y-visible dark:text-slate-200"
      aria-label="Main navigation"
      id="navigation-menu"
    >
      <ul class="flex w-full flex-col text-xl font-medium tracking-[0.01rem] md:w-auto md:flex-row md:justify-end md:self-center md:text-[0.875rem]">
        {NAVIGATION.map((item) => (
          <li>
            <a
              class="flex items-center px-3 py-3 transition duration-150 ease-in-out hover:text-gray-900 lg:px-4 dark:hover:text-white"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex flex-col gap-3 px-4 pb-4 md:hidden">
        <a href={ASSESSMENT_HREF} class="btn-primary w-full px-5 py-2.5 text-sm">Start Assessment</a>
        <a
          href={CONTACT.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp w-full px-5 py-2.5 text-sm"
        >
          WhatsApp
        </a>
      </div>
    </nav>

    <div class="hidden items-center md:mb-0 md:flex md:self-center">
      <div class="flex w-full items-center justify-between md:w-auto">
        <button
          type="button"
          class="theme-toggle inline-flex items-center rounded-lg p-2.5 text-sm text-muted hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-800 dark:focus:ring-gray-700"
          aria-label="Toggle dark mode"
        >
          <svg class="sun-icon hidden h-6 w-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
          <svg class="moon-icon h-6 w-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
        </button>
        <div class="ml-3">
          <a href={ASSESSMENT_HREF} class="btn-primary px-5 py-2.5 text-sm font-semibold shadow-none">Start Assessment</a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const themeToggles = document.querySelectorAll('.theme-toggle');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const navMenu = document.getElementById('navigation-menu');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll('.sun-icon').forEach((el) => el.classList.toggle('hidden', !isDark));
    document.querySelectorAll('.moon-icon').forEach((el) => el.classList.toggle('hidden', isDark));
  }

  function onScroll() {
    header?.classList.toggle('scroll', window.scrollY > 10);
  }

  updateThemeUI();
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  themeToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI();
    });
  });

  menuBtn?.addEventListener('click', () => {
    const open = navMenu?.classList.toggle('hidden') === false;
    header?.classList.toggle('expanded', open);
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const meridians = [8, 18, 28, 38, 48, 58, 68, 78, 88];
const parallels = [18, 32, 46, 60, 74];
const arcs = [
  'M22 54 C 30 40, 38 32, 41 28',
  'M22 54 C 34 42, 44 34, 48 31',
  'M22 54 C 36 38, 46 28, 50 24',
  'M22 54 C 20 44, 18 38, 18 36',
  'M22 54 C 22 40, 22 30, 22 24',
  'M22 54 C 40 50, 52 48, 60 46',
  'M22 54 C 38 50, 50 46, 56 42',
  'M22 54 C 42 64, 62 72, 80 74',
];
---

<div class:list={['journey', compact && 'journey--compact']} aria-hidden="true">
  <div class="journey-stage" data-parallax>
    <svg viewBox="0 0 100 90" class="journey-svg" overflow="visible">
      <defs>
        <radialGradient id="journeyGlow" cx="48%" cy="42%" r="52%">
          <stop offset="0%" stop-color="#C9A227" stop-opacity="0.16"></stop>
          <stop offset="42%" stop-color="#0B1F3A" stop-opacity="0.04"></stop>
          <stop offset="100%" stop-color="#0B1F3A" stop-opacity="0"></stop>
        </radialGradient>
        <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="0.6" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>
      <rect width="100" height="86" fill="url(#journeyGlow)"></rect>
      <ellipse cx="48" cy="42" rx="42" ry="28" fill="none" stroke="#142B4A" stroke-opacity="0.18" stroke-width="0.18"></ellipse>
      <ellipse cx="48" cy="42" rx="32" ry="20" fill="none" stroke="#142B4A" stroke-opacity="0.16" stroke-width="0.16"></ellipse>
      <ellipse cx="48" cy="42" rx="20" ry="12" fill="none" stroke="#C9A227" stroke-opacity="0.22" stroke-width="0.14"></ellipse>
      {parallels.map((y) => (
        <path d={`M8 ${y} C 30 ${y - 3}, 66 ${y + 3}, 92 ${y}`} fill="none" stroke="#0B1F3A" stroke-opacity="0.08" stroke-width="0.12"></path>
      ))}
      {meridians.map((x) => (
        <path d={`M${x} 14 C ${x - 4} 42, ${x + 4} 42, ${x} 76`} fill="none" stroke="#0B1F3A" stroke-opacity="0.07" stroke-width="0.12"></path>
      ))}
      {arcs.map((d) => (
        <path class="journey-arc" d={d} fill="none" stroke="#0B1F3A" stroke-opacity="0.22" stroke-width="0.18"></path>
      ))}
      <g class="origin">
        <circle cx="22" cy="54" r="1.15" fill="#0B1F3A"></circle>
        <circle cx="22" cy="54" r="2.3" fill="none" stroke="#C9A227" stroke-opacity="0.45" stroke-width="0.16"></circle>
      </g>
      <g filter="url(#nodeGlow)">
        <circle class="dest dest-gold" cx="41" cy="28" r="1.05" fill="#C9A227"></circle>
        <circle class="dest" cx="48" cy="31" r="0.9" fill="#0B1F3A"></circle>
        <circle class="dest dest-gold" cx="50" cy="24" r="0.95" fill="#C9A227"></circle>
        <circle class="dest" cx="18" cy="36" r="0.9" fill="#0B1F3A"></circle>
        <circle class="dest" cx="22" cy="24" r="0.85" fill="#142B4A"></circle>
        <circle class="dest dest-gold" cx="60" cy="46" r="1" fill="#C9A227"></circle>
        <circle class="dest" cx="56" cy="42" r="0.85" fill="#0B1F3A"></circle>
        <circle class="dest" cx="80" cy="74" r="0.95" fill="#142B4A"></circle>
      </g>
      <g class="labels" fill="#4b5563" font-size="3" font-weight="600" font-family="Manrope, sans-serif">
        <text x="41" y="24.6" text-anchor="middle">UK</text>
        <text x="46.5" y="37.4" text-anchor="middle">Germany</text>
        <text x="56" y="21.8">Europe</text>
        <text x="17.5" y="32.2" text-anchor="middle">USA</text>
        <text x="22" y="20.4" text-anchor="middle">Canada</text>
        <text x="65" y="50.2">UAE</text>
        <text x="57.5" y="39.6" text-anchor="middle">Saudi</text>
        <text x="78" y="80.2" text-anchor="middle">Australia</text>
      </g>
      {arcs.map((_, i) => (
        <circle class="journey-particle" r="0.42" fill={i % 3 === 0 ? '#C9A227' : '#0B1F3A'}>
          <animateMotion dur={`${7 + (i % 4)}s`} repeatCount="indefinite" rotate="auto">
            <mpath href={`#jp${i}`}></mpath>
          </animateMotion>
        </circle>
      ))}
      {arcs.map((d, i) => <path id={`jp${i}`} d={d} fill="none"></path>)}
    </svg>
  </div>
  <p class="journey-note">Visual destinations only — not an offer of every immigration route.</p>
</div>

<style>
  .journey {
    position: relative;
    min-height: 22rem;
  }
  .journey-stage {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .journey-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .journey-note {
    margin: 0.6rem 0 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #667085;
  }
  .dest {
    opacity: 0;
    animation: nodeIn 0.7s ease forwards;
  }
  .dest:nth-child(1) { animation-delay: 0.1s; }
  .dest:nth-child(2) { animation-delay: 0.18s; }
  .dest:nth-child(3) { animation-delay: 0.26s; }
  .dest:nth-child(4) { animation-delay: 0.34s; }
  .dest:nth-child(5) { animation-delay: 0.42s; }
  .dest:nth-child(6) { animation-delay: 0.5s; }
  .dest:nth-child(7) { animation-delay: 0.58s; }
  .dest:nth-child(8) { animation-delay: 0.66s; }
  .dest-gold {
    filter: drop-shadow(0 0 2px rgba(201, 162, 39, 0.55));
  }
  .journey-arc {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
    animation: draw 2.4s ease forwards;
  }
  @keyframes nodeIn {
    to { opacity: 1; }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @media (max-width: 767px) {
    .journey { min-height: 16rem; }
    .labels { display: none; }
    .journey-particle { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dest, .journey-arc { animation: none; opacity: 1; stroke-dashoffset: 0; }
    .journey-particle { display: none; }
    .journey-stage { transform: none !important; }
  }
</style>

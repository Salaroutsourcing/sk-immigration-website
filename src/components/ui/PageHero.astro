---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  compact?: boolean;
}

const { eyebrow, title, text, compact = false } = Astro.props;
---

<section class:list={['sk-wrap', compact ? 'py-10 md:py-12' : 'py-14 md:py-16']}>
  <div class:list={[compact ? 'max-w-3xl' : 'max-w-3xl']}>
    {eyebrow && <p class="sk-eyebrow">{eyebrow}</p>}
    <h1 class="sk-h1 !text-[clamp(2rem,4.4vw,3.4rem)]">{title}</h1>
    {text && <p class="sk-lead mt-5">{text}</p>}
  </div>
</section>

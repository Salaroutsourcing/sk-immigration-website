---
import { SITE } from '../../lib/site';

interface Props {
  label?: string;
  placement?: 'in-article' | 'in-feed' | 'display' | 'anchor';
}

const { label = 'Advertisement', placement = 'in-article' } = Astro.props;

const format =
  placement === 'in-article' ? 'fluid' : placement === 'in-feed' ? 'fluid' : 'auto';
---

<aside class={`ad-slot ad-slot--${placement}`} aria-label={label}>
  <p class="ad-slot__label">{label}</p>
  <div class={`ad-slot__box sk-ad-slot sk-ad-${placement}`}>
    <ins
      class="adsbygoogle"
      style={placement === 'in-article' ? 'display:block;text-align:center;' : 'display:block'}
      data-ad-client={SITE.analytics.adsense}
      data-ad-slot="auto"
      data-ad-format={format}
      data-ad-layout={placement === 'in-article' ? 'in-article' : undefined}
      data-full-width-responsive="true"></ins>
  </div>
</aside>

<style>
  .ad-slot {
    margin: 1.75rem 0;
    text-align: center;
  }
  .ad-slot__label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.4rem;
  }
  .ad-slot__box {
    min-height: 90px;
    border-radius: 12px;
    overflow: hidden;
  }
  .ad-slot--in-article .ad-slot__box,
  .ad-slot--in-feed .ad-slot__box {
    min-height: 250px;
  }
  .ad-slot ins.adsbygoogle {
    min-height: inherit;
  }
</style>

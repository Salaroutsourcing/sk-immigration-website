---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HUB_META, landerPath, landersIn } from '../lib/landers';
import ClusterNotice from './ClusterNotice.astro';
import AuthoritySplit from './home/AuthoritySplit.astro';
import BeforeYouPay from './home/BeforeYouPay.astro';
import FinalCta from './home/FinalCta.astro';

interface Props {
  cluster: string;
}

const { cluster } = Astro.props;
const meta = HUB_META[cluster];
const items = (await landersIn(cluster)).filter((entry) => entry.data.slug !== 'index' && entry.data.slug !== 'hub');
const path = `/${cluster}/`;
---

<BaseLayout title={meta.title} description={meta.description} canonical={path} page={cluster}>
  <section class="sk-wrap py-14 md:py-16">
    <p class="sk-eyebrow">{meta.kicker}</p>
    <h1 class="sk-h1 !text-[clamp(2rem,4.4vw,3.4rem)] max-w-3xl">{meta.title}</h1>
    <p class="sk-lead mt-5">{meta.description}</p>
    <div class="mt-6 max-w-2xl">
      <ClusterNotice cluster={cluster} />
    </div>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/contact/" class="btn-primary">Start My Assessment</a>
      <a href="/services/" class="btn">Explore Services</a>
    </div>
  </section>
  <AuthoritySplit compact />
  <section class="sk-section sk-section--canvas">
    <div class="sk-wrap">
      <h2 class="sk-h2 mb-8">Destinations and guides</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((entry) => (
          <a href={landerPath(entry)} class="sk-card">
            <h3 class="!text-[1.08rem]">{entry.data.h1}</h3>
            <p class="line-clamp-3">{entry.data.description}</p>
            <div class="sk-card-foot">
              <span></span>
              <span class="sk-card-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <div class="sk-wrap pb-8">
    <BeforeYouPay embedded />
  </div>
  <FinalCta />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../lib/config';
import { HUB_META, landerPath, landersIn } from '../lib/landers';

interface Props {
  cluster: string;
}

const { cluster } = Astro.props;
const meta = HUB_META[cluster];
const items = (await landersIn(cluster)).filter((entry) => entry.data.slug !== 'index' && entry.data.slug !== 'hub');
const path = `/${cluster}/`;
---

<BaseLayout title={meta.title} description={meta.description} canonical={path} page={cluster}>
  <section class="not-prose border-b border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-dark-950 md:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">{meta.kicker}</p>
      <h1 class="mb-4 font-heading text-3xl font-bold text-slate-900 md:text-5xl dark:text-white">{meta.title}</h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-400">{meta.description}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact/" class="btn-primary">Free consultation</a>
        <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
          WhatsApp {CONTACT.phoneFormatted}
        </a>
      </div>
    </div>
  </section>
  <section class="section-container not-prose">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <a
          href={landerPath(entry)}
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-primary-500/40 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
        >
          <h2 class="mb-2 font-heading text-lg font-bold text-slate-900 dark:text-white">{entry.data.h1}</h2>
          <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{entry.data.description}</p>
          <p class="mt-3 text-xs font-bold text-primary-600">Open guide →</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

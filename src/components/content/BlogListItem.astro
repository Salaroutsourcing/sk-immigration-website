---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  image?: string;
  readingMinutes?: number;
  tags?: string[];
  featured?: boolean;
}

const {
  href,
  title,
  excerpt,
  date,
  category,
  image = '/assets/img/hero-graduation.jpg',
  readingMinutes,
  featured = false,
} = Astro.props;

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['card-premium not-prose flex h-full flex-col overflow-hidden p-0', featured ? 'md:col-span-2 lg:col-span-3 md:grid md:grid-cols-2 md:items-stretch' : '']}>
  <a href={href} class="block overflow-hidden">
    <img
      src={image}
      alt=""
      class:list={['w-full object-cover', featured ? 'aspect-[16/10] h-full max-h-[22rem]' : 'aspect-[16/10]']}
      loading={featured ? 'eager' : 'lazy'}
      width={featured ? 800 : 640}
      height={featured ? 500 : 400}
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <p class="mb-2 text-xs text-muted">
      {category && <span class="eyebrow mr-2">{category}</span>}
      <time datetime={date.toISOString()}>{formatted}</time>
      {readingMinutes && (
        <>
          <span aria-hidden="true"> · </span>
          <span>{readingMinutes} min read</span>
        </>
      )}
    </p>
    <h2 class:list={['font-heading font-bold tracking-tight text-ink dark:text-white', featured ? 'text-2xl' : 'text-lg']}>
      <a class="hover:text-primary" href={href}>{title}</a>
    </h2>
    <p class:list={['mt-2 flex-1 text-muted', featured ? 'text-base leading-[1.65]' : 'line-clamp-3 text-sm leading-[1.6]']}>
      {excerpt}
    </p>
    <a href={href} class="mt-4 text-sm font-semibold text-primary">Read guide →</a>
  </div>
</article>

---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  image?: string;
  readingMinutes?: number;
  tags?: string[];
  featured?: boolean;
}

const {
  href,
  title,
  excerpt,
  date,
  category,
  image = '/assets/img/hero-graduation.jpg',
  readingMinutes,
  tags = [],
  featured = false,
} = Astro.props;

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['not-prose', featured ? 'grid items-center gap-6 md:grid-cols-2 md:gap-8' : 'flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6']}>
  <a href={href} class:list={['block overflow-hidden rounded-md', featured ? '' : 'sm:w-1/3 sm:shrink-0']}>
    <img
      src={image}
      alt=""
      class:list={['w-full object-cover', featured ? 'aspect-[16/10] max-h-[22rem]' : 'aspect-[16/10] max-h-44 sm:max-h-36']}
      loading={featured ? 'eager' : 'lazy'}
      width={featured ? 800 : 480}
      height={featured ? 500 : 300}
    />
  </a>
  <div class="min-w-0">
    <p class="mb-1.5 text-sm text-slate-500 dark:text-slate-400">
      <time datetime={date.toISOString()}>{formatted}</time>
      {category && (
        <>
          <span aria-hidden="true"> · </span>
          <span class="capitalize">{category.replace(/-/g, ' ')}</span>
        </>
      )}
      {readingMinutes && (
        <>
          <span aria-hidden="true"> · </span>
          <span>{readingMinutes} min read</span>
        </>
      )}
    </p>
    <h2 class:list={['font-heading font-bold tracking-tight text-slate-900 dark:text-white', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
      <a class="text-primary hover:underline" href={href}>{title}</a>
    </h2>
    <p class:list={['mt-2 text-slate-600 dark:text-slate-400', featured ? 'text-base' : 'line-clamp-2 text-sm']}>
      {excerpt}
    </p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.slice(0, 4).map((tag) => (
          <li class="rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold capitalize text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {tag.replace(/-/g, ' ')}
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  image?: string;
  readingMinutes?: number;
  tags?: string[];
  featured?: boolean;
}

const {
  href,
  title,
  excerpt,
  date,
  category,
  image = '/assets/img/hero-graduation.jpg',
  readingMinutes,
  featured = false,
} = Astro.props;

const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class:list={['not-prose', featured ? 'grid items-center gap-6 md:grid-cols-2 md:gap-8' : '']}>
  {featured ? (
    <>
      <a href={href} class="block overflow-hidden rounded-xl">
        <img src={image} alt="" class="aspect-[16/10] w-full object-cover" width="800" height="500" loading="eager" />
      </a>
      <div>
        <p class="sk-eyebrow">{category || 'Guide'}</p>
        <h2 class="text-2xl font-extrabold tracking-tight text-navy sm:text-3xl">
          <a href={href}>{title}</a>
        </h2>
        <p class="mt-3 text-ink-soft">{excerpt}</p>
        <p class="mt-3 text-sm text-ink-soft">
          <time datetime={date.toISOString()}>{formatted}</time>
          {readingMinutes ? ` · ${readingMinutes} min read` : ''}
        </p>
      </div>
    </>
  ) : (
    <a class="sk-card sm:flex-row" href={href}>
      <span class="sk-card-n">{category || 'Guide'}</span>
      <h3 class="!text-[1.08rem]">{title}</h3>
      <p class="line-clamp-2">{excerpt}</p>
      <div class="sk-card-foot text-xs text-ink-soft">
        <span>
          <time datetime={date.toISOString()}>{formatted}</time>
          {readingMinutes ? ` · ${readingMinutes} min` : ''}
        </span>
        <span class="sk-card-arrow">→</span>
      </div>
    </a>
  )}
</article>

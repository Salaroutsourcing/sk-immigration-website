---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  kind?: 'news' | 'blog' | 'story';
  ampHref?: string;
}

const { href, title, excerpt, date, category, kind = 'news', ampHref } = Astro.props;
const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="flex flex-col rounded-lg border border-gray-200 bg-white p-6 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900" data-kind={kind}>
  <a class="flex flex-1 flex-col gap-2 no-underline" href={href}>
    <div class="flex gap-2 text-xs capitalize text-slate-500 dark:text-slate-400">
      {category && <span class="font-semibold text-primary-600">{category.replace('-', ' ')}</span>}
      <time datetime={date.toISOString()}>{formatted}</time>
    </div>
    <h3 class="font-heading text-lg font-bold leading-snug text-slate-900 dark:text-white">{title}</h3>
    <p class="text-sm text-slate-600 dark:text-slate-400">{excerpt}</p>
  </a>
  {ampHref && (
    <a class="mt-3 text-xs font-bold text-primary-600 hover:underline" href={ampHref}>Open AMP Web Story</a>
  )}
</article>

---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  kind?: 'news' | 'blog' | 'story';
  ampHref?: string;
  readingMinutes?: number;
}

const { href, title, excerpt, date, category, kind = 'news', ampHref, readingMinutes } = Astro.props;
const formatted = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const ctaLabel = kind === 'news' ? 'Read update →' : kind === 'story' ? 'Open story →' : 'Read guide →';
---

<article class="flex flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900" data-kind={kind}>
  <a class="flex flex-1 flex-col gap-1.5 no-underline" href={href}>
    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      {category && <span class="font-semibold uppercase tracking-wide text-primary-600">{category.replace(/-/g, ' ')}</span>}
      <time datetime={date.toISOString()}>{formatted}</time>
      {readingMinutes && <span>· {readingMinutes} min read</span>}
    </div>
    <h3 class="font-heading text-lg font-bold leading-snug text-slate-900 dark:text-white">{title}</h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{excerpt}</p>
    <span class="mt-2 text-sm font-semibold text-primary">{ctaLabel}</span>
  </a>
  {ampHref && (
    <a class="mt-3 text-xs font-bold text-primary-600 hover:underline" href={ampHref}>Open AMP Web Story</a>
  )}
</article>

---
import { COUNTRY_PATHWAYS } from '../../lib/home';

interface Props {
  country: string;
}

const { country } = Astro.props;
---

<nav class="sk-wrap mb-8" aria-label={`${country} pathways`}>
  <div class="rounded-xl border border-line bg-canvas px-5 py-4">
    <p class="text-[0.7rem] font-bold tracking-[0.16em] uppercase text-gold">{country}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {COUNTRY_PATHWAYS.map((item) => (
        <li>
          <a class="inline-flex rounded-md border border-line bg-white px-3 py-1.5 text-sm font-semibold text-navy hover:border-gold" href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

---
import type { RelatedLink } from '../../lib/article';

interface Props {
  items: RelatedLink[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="not-prose mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
    <h2 class="mb-4 font-heading text-xl font-bold text-slate-900 dark:text-white">Continue reading</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {items.slice(0, 4).map((item) => (
        <a
          href={item.href}
          class="rounded-lg border border-gray-200 bg-white p-4 transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
        >
          {item.category && (
            <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-primary">{item.category}</p>
          )}
          <p class="font-heading text-base font-bold leading-snug text-slate-900 dark:text-white">{item.title}</p>
          {item.description && (
            <p class="mt-1 line-clamp-2 text-sm text-muted dark:text-slate-400">{item.description}</p>
          )}
        </a>
      ))}
    </div>
  </section>
)}

---
import type { RelatedLink } from '../../lib/article';

interface Props {
  items: RelatedLink[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="not-prose mt-10 border-t border-line pt-8">
    <h2 class="mb-4 font-heading text-xl font-bold text-navy">Related guides</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {items.slice(0, 4).map((item) => (
        <a href={item.href} class="sk-card">
          {item.category && <p class="sk-card-n">{item.category}</p>}
          <h3 class="!text-[1.02rem] !leading-snug">{item.title}</h3>
          {item.description && <p class="line-clamp-2">{item.description}</p>}
        </a>
      ))}
    </div>
  </section>
)}

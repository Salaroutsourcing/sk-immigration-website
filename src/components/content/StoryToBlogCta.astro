---
interface Props {
  eyebrow?: string;
  title: string;
  href: string;
  cta?: string;
}

const { eyebrow = 'Read the full guide', title, href, cta = 'Open the blog' } = Astro.props;
---

<aside class="story-to-blog">
  <p class="story-to-blog__kicker">{eyebrow}</p>
  <h2>{title}</h2>
  <a class="btn btn-gold" href={href}>{cta}</a>
</aside>

<style>
  .story-to-blog {
    margin: 2rem 0;
    padding: 1.4rem 1.5rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.14), var(--glass));
    border: 1px solid var(--glass-border);
  }
  .story-to-blog__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 0.35rem;
  }
  .story-to-blog h2 {
    font-size: 1.25rem;
    margin-bottom: 0.85rem;
  }
</style>

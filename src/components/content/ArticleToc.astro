---
import type { TocItem } from '../../lib/article';

interface Props {
  items: TocItem[];
  variant?: 'panel' | 'aside';
}

const { items, variant = 'panel' } = Astro.props;
const show = items.length >= 4;
---

{show && variant === 'panel' && (
  <nav class="sk-toc lg:hidden" aria-label="In this guide">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">In this guide</p>
    <ol class="space-y-1.5 text-sm">
      {items.map((item) => (
        <li class={item.level === 3 ? 'pl-3' : ''}>
          <a class="text-navy hover:text-gold" href={`#${item.id}`}>{item.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

{show && variant === 'aside' && (
  <nav class="not-prose hidden rounded-xl border border-line bg-white p-5 lg:block" aria-label="In this guide">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-ink-soft">In this guide</p>
    <ol class="space-y-1.5 text-sm">
      {items.map((item) => (
        <li class={item.level === 3 ? 'pl-3' : ''}>
          <a class="text-navy hover:text-gold" href={`#${item.id}`}>{item.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

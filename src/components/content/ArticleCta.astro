---
import { ASSESSMENT_HREF, SERVICES_HREF } from '../../lib/home';

interface Props {
  heading?: string;
}

const {
  heading = 'Need help understanding your options?',
} = Astro.props;
---

<div class="not-prose mt-8 rounded-xl border border-line bg-page px-5 py-6 text-center dark:border-slate-800 dark:bg-secondary">
  <h2 class="font-heading mb-1.5 text-xl font-bold text-ink dark:text-white">{heading}</h2>
  <p class="mx-auto mb-4 max-w-lg text-sm leading-snug text-muted">
    Reading a guide can help you understand the process, but every situation is different.
  </p>
  <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
    <a href={SERVICES_HREF} class="btn">Explore Services</a>
  </div>
</div>

---
import { ASSESSMENT_HREF, WHATSAPP_HREF } from '../../lib/home';

interface Props {
  heading?: string;
}

const {
  heading = 'Need help understanding your options?',
} = Astro.props;
---

<div class="not-prose mt-10 rounded-md border border-gray-200 bg-slate-50 px-6 py-8 text-center dark:border-slate-800 dark:bg-slate-900 md:py-9">
  <h2 class="font-heading mb-2 text-2xl font-bold text-slate-900 dark:text-white">{heading}</h2>
  <p class="mx-auto mb-5 max-w-lg text-sm leading-relaxed text-muted dark:text-slate-400">
    Reading a guide can help you understand the process, but every situation is different.
  </p>
  <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
    <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Chat on WhatsApp</a>
  </div>
  <p class="mx-auto mt-5 max-w-lg text-xs leading-relaxed text-muted">
    We provide guidance and preparation support. Authorities make the final decisions.
  </p>
</div>

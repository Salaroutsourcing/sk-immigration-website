---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedNews } from '../../lib/content';
import { NEWS_CATEGORIES, SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';

const items = await publishedNews();
---

<BaseLayout
  title={`Immigration news from Pakistan | ${SITE.brandFull}`}
  description="Daily visa, study-abroad, and policy news for Pakistani students and professionals. Written for Google, AI citation, and real decisions."
  canonical="/news/"
  page="news"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
    ]),
    collectionPageSchema({
      name: `Immigration news from Pakistan | ${SITE.brandFull}`,
      description: 'Daily visa, study-abroad, and policy news for Pakistani students and professionals.',
      url: absoluteUrl('/news/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/news/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="not-prose">
    <div class="page-intro max-w-4xl">
      <p class="eyebrow">Newsroom</p>
      <span class="accent-line mx-auto"></span>
      <h1 class="font-heading mt-3 mb-4 text-3xl font-bold tracking-tight text-ink md:text-5xl dark:text-white">News that sends readers to the right guide</h1>
      <p class="mx-auto max-w-2xl text-base leading-[1.65] text-muted">
        Short, sourced updates. Each story can open a Web Story for reach and a long-form guide for ranking.
      </p>
    </div>
  </section>
  <section class="section-container not-prose">
    <nav class="mb-8 flex flex-wrap gap-2" aria-label="News categories">
      <a class="rounded-full bg-primary-600 px-3 py-1 text-xs font-semibold text-white" href="/news/" aria-current="page">All</a>
      {NEWS_CATEGORIES.map((item) => (
        <a class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold capitalize text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200" href={`/news/category/${item}/`}>
          {item.replace('-', ' ')}
        </a>
      ))}
    </nav>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <ContentCard
          kind="news"
          href={`/news/${entry.id}/`}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { publishedNews } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, newsArticleSchema } from '../../lib/seo';
import { render } from 'astro:content';
import {
  headingsFromMarkdown,
  officialSourcesFor,
  readingMinutesFromText,
  relatedServicesFor,
} from '../../lib/article';

export async function getStaticPaths() {
  const items = await publishedNews();
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/news/${entry.id}/`;
const relatedBlogHref = entry.data.relatedBlog ? `/blog/${entry.data.relatedBlog}/` : undefined;
const toc = headingsFromMarkdown(entry.body);
const readingMinutes = readingMinutesFromText(entry.body);
const newsSources = entry.data.sources.map((source) => ({ label: source.name, url: source.url }));
---

<ArticleLayout
  title={`${entry.data.title} | ${SITE.brand}`}
  description={entry.data.description}
  canonical={path}
  published={entry.data.publishDate}
  updated={entry.data.updatedDate}
  image={entry.data.heroImage}
  page="news"
  category={entry.data.category}
  crumbs={[
    { name: 'Home', path: '/' },
    { name: 'News', path: '/news/' },
    { name: entry.data.title, path },
  ]}
  relatedBlogHref={relatedBlogHref}
  relatedBlogTitle={relatedBlogHref ? 'Continue with the in-depth guide' : undefined}
  toc={toc}
  readingMinutes={readingMinutes}
  relatedServices={relatedServicesFor('news')}
  officialSources={newsSources.length ? newsSources : officialSourcesFor('news')}
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
      { name: entry.data.title, path },
    ]),
    newsArticleSchema({
      headline: entry.data.title,
      description: entry.data.description,
      url: absoluteUrl(path),
      datePublished: entry.data.publishDate,
      dateModified: entry.data.updatedDate,
      image: entry.data.heroImage,
      keywords: entry.data.keywords,
      dateline: entry.data.dateline,
      articleSection: entry.data.category,
      sources: entry.data.sources,
      relatedBlog: entry.data.relatedBlog,
    }),
  ]}
>
  <Content />
</ArticleLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/content/ContentCard.astro';
import AdSlot from '../../../components/ads/AdSlot.astro';
import { newsByCategory, publishedNews } from '../../../lib/content';
import { NEWS_CATEGORIES, SITE, absoluteUrl } from '../../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  return NEWS_CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const items = await newsByCategory(category);
const all = await publishedNews();
const path = `/news/category/${category}/`;
---

<BaseLayout
  title={`${category.replace('-', ' ')} news | ${SITE.brandFull}`}
  description={`Latest ${category.replace('-', ' ')} updates for Pakistani students and workers from SK Immigration Services.`}
  canonical={path}
  page="news"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
      { name: category, path },
    ]),
    collectionPageSchema({
      name: `${category.replace('-', ' ')} news | ${SITE.brandFull}`,
      description: `Latest ${category.replace('-', ' ')} updates for Pakistani students and workers from SK Immigration Services.`,
      url: absoluteUrl(path),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/news/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="not-prose border-b border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-dark-950 md:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">Newsroom</p>
      <h1 class="mb-3 font-heading text-3xl font-bold capitalize text-slate-900 md:text-5xl dark:text-white">
        {category.replace('-', ' ')}
      </h1>
      <p class="text-slate-600 dark:text-slate-400">
        {items.length} update{items.length === 1 ? '' : 's'} in this category.
      </p>
    </div>
  </section>
  <section class="section-container not-prose">
    <nav class="mb-8 flex flex-wrap gap-2" aria-label="News categories">
      <a class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-200" href="/news/">All</a>
      {NEWS_CATEGORIES.map((item) => (
        <a
          class:list={[
            'rounded-full px-3 py-1 text-xs font-semibold capitalize',
            item === category ? 'bg-primary-600 text-white' : 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200',
          ]}
          href={`/news/category/${item}/`}
          aria-current={item === category ? 'page' : undefined}
        >
          {item.replace('-', ' ')}
        </a>
      ))}
    </nav>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <ContentCard
          kind="news"
          href={`/news/${entry.id}/`}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    {items.length === 0 && (
      <p class="text-slate-600 dark:text-slate-400">No stories in this category yet. Browse the {all.length} updates in the full newsroom.</p>
    )}
    {items.length > 0 && <AdSlot placement="in-feed" />}
  </section>
</BaseLayout>

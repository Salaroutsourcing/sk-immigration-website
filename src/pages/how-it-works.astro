---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { PROCESS_STEPS, ASSESSMENT_HREF, WHATSAPP_HREF } from '../lib/home';
import PageHero from '../components/ui/PageHero.astro';
import ProcessTimeline from '../components/home/ProcessTimeline.astro';
import FeesBlock from '../components/home/FeesBlock.astro';
import BeforeYouPay from '../components/home/BeforeYouPay.astro';
import AuthoritySplit from '../components/home/AuthoritySplit.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'How It Works', item: `${SITE.url}/how-it-works/` },
  ],
};
---

<BaseLayout
  title="How It Works — SK Immigration"
  description="A clear remote process: tell us your goal, receive a roadmap, and get documentation support. Government, embassy, university and regulatory decisions remain outside our control."
  canonical="/how-it-works/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <PageHero
    eyebrow="Process"
    title="From the first conversation to the next step."
    text="You don’t have to figure everything out alone. We help you prepare — without promising the outcome."
  />
  <ProcessTimeline />
  <section class="sk-section sk-section--canvas">
    <div class="sk-wrap max-w-3xl">
      <h2 class="sk-h2 mb-8">Working with us</h2>
      <ol class="space-y-6">
        {PROCESS_STEPS.map((step) => (
          <li class="grid grid-cols-[auto_1fr] gap-4">
            <span class="text-xs font-bold tracking-[0.14em] text-gold">{step.n}</span>
            <div>
              <h3 class="text-lg font-bold text-navy">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-sm text-ink-soft">Government, embassy, university and regulatory decisions remain outside our control.</p>
    </div>
  </section>
  <FeesBlock />
  <AuthoritySplit compact />
  <div class="sk-wrap">
    <BeforeYouPay embedded />
  </div>
  <section class="sk-wrap pb-20">
    <div class="rounded-2xl bg-navy px-6 py-12 text-center text-white">
      <h2 class="text-2xl font-extrabold tracking-tight">Ready to talk through your options?</h2>
      <p class="mx-auto mt-3 max-w-lg text-white/70">No pressure. No false promises. Just a clear conversation.</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={ASSESSMENT_HREF} class="btn-primary !bg-gold !border-gold !text-navy-dark">Start My Assessment</a>
        <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, CONTACT, BUSINESS } from '../lib/config';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact/` },
  ],
};
---

<BaseLayout
  title="Start your assessment — SK Immigration"
  description="Tell us what you're planning. We'll help you understand your options and the steps involved — completely online, with no false promises."
  canonical="/contact/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="eyebrow">Assessment</p>
        <span class="accent-line mx-auto"></span>
        <h1 class="font-heading mt-3 mb-4 text-3xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">
          Tell us what you're planning
        </h1>
        <p class="text-base leading-[1.65] text-muted sm:text-lg">
          You don't need to have everything figured out. We'll help you understand your options — no pressure, no
          false promises.
        </p>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-12">
        <div class="rounded-xl border border-line bg-white p-6 shadow-[0_1px_2px_rgba(11,31,58,0.04)] md:p-8 dark:border-slate-800 dark:bg-slate-900 lg:col-span-7">
          <h2 class="font-heading mb-2 text-2xl font-bold text-slate-900 dark:text-white" id="assessment">Start an assessment</h2>
          <p class="mb-6 text-sm text-muted dark:text-slate-400">
            We typically reply within 24 hours. Talk to our team on WhatsApp if that's easier.
          </p>
          <ContactForm />
        </div>
        <div class="space-y-6 lg:col-span-5">
          <div class="rounded-xl border border-line bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="font-heading mb-4 text-lg font-bold text-slate-900 dark:text-white">Talk to our team</h2>
            <p class="mb-4 text-sm text-muted dark:text-slate-400">
              Remote support first. Company identity details are below for verification.
            </p>
            <div class="space-y-3 text-sm text-muted dark:text-slate-400">
              <p><strong class="text-slate-900 dark:text-white">Address:</strong> {CONTACT.address.full}</p>
              <p><strong class="text-slate-900 dark:text-white">Hours:</strong> {CONTACT.hours}</p>
              <p>
                <strong class="text-slate-900 dark:text-white">Phone:</strong>
                <a href={`tel:${CONTACT.phone}`} class="hover:text-primary">{CONTACT.phoneFormatted}</a>
              </p>
              <p>
                <strong class="text-slate-900 dark:text-white">Email:</strong>
                <a href={`mailto:${CONTACT.email}`} class="hover:text-primary">{CONTACT.email}</a>
              </p>
            </div>
            <a
              href={BUSINESS.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-block text-sm font-medium text-primary hover:underline"
            >
              Open in Google Maps ↗
            </a>
          </div>
          <div class="rounded-xl bg-primary px-6 py-8 text-center text-white">
            <h2 class="font-heading mb-2 text-xl font-bold text-white">Ask us about your situation</h2>
            <p class="mb-5 text-sm text-white/75">
              Chat with us on WhatsApp — same official number as the site button.
            </p>
            <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full sm:w-auto">
              Chat With Us on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

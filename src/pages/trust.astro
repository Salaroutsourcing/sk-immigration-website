---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, BUSINESS } from '../lib/config';
import { ASSESSMENT_HREF, WHATSAPP_HREF, NEVER_PROMISE, WE_PROMISE } from '../lib/home';
import AuthoritySplit from '../components/home/AuthoritySplit.astro';
import BeforeYouPay from '../components/home/BeforeYouPay.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Trust', item: `${SITE.url}/trust/` },
  ],
};
---

<BaseLayout
  title="Trust & Transparency — SK Immigration"
  description="How SK Immigration works: what we do, what we don't do, how fees work, and why we never promise government or university outcomes."
  canonical="/trust/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-16 max-w-3xl text-center">
        <p class="text-base font-semibold uppercase tracking-wide text-primary">Trust &amp; transparency</p>
        <h1 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          Your trust is more valuable than a sale.
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          We won't promise you the outcome. We'll help you prepare properly for the journey.
        </p>
      </div>

      <div class="mx-auto max-w-4xl space-y-12">
        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Who we are</h2>
          <p class="mb-3 leading-relaxed text-muted dark:text-slate-400">
            SK Immigration is a digital immigration and business-services consultancy. We help individuals and
            businesses understand international processes, prepare documentation and move forward with clarity —
            completely online.
          </p>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            Legal name: <strong class="text-slate-800 dark:text-slate-200">{SITE.legalName}</strong>
            {BUSINESS.cuin && (
              <>
                {' '}
                (registered company, CUIN {BUSINESS.cuin}). Company registration identifies the business. It does not
                mean government-approved immigration outcomes.
              </>
            )}
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">What we do</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            We provide documentation, preparation and guidance for study pathways, visit visas, vocational-training
            applications, sponsor-driven Saudi processing, document attestation, appointment preparation, and
            international company-registration documentation. See <a href="/services/" class="text-primary hover:underline">Services</a>.
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">What we don't do</h2>
          <ul class="space-y-2 text-muted dark:text-slate-400">
            {NEVER_PROMISE.map((item) => (
              <li class="flex gap-2">
                <span aria-hidden="true">✕</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 font-medium text-slate-800 dark:text-slate-200">
            We do not offer, arrange or sell jobs in Saudi Arabia.
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Our role</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            We prepare files, explain processes and help you understand what is typically required. We do not replace
            embassies, immigration authorities, universities or company-registration bodies. Those organizations review
            applications and make the decisions.
          </p>
        </section>

        <AuthoritySplit compact />

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Fee transparency</h2>
          <p class="mb-3 leading-relaxed text-muted dark:text-slate-400">
            Our service fee is the amount charged by SK Immigration for the agreed work. Government, embassy,
            university, visa-centre, medical, courier and registration-authority charges are separate and paid to
            those providers.
          </p>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            You should know the scope and the fee distinction before you pay. We do not invent a single public price
            for every case — written scope comes after we understand your situation.
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">No-guarantee policy</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            Government, embassy, university and regulatory decisions remain outside our control. We will never tell
            you something is guaranteed when it isn't. What we can control is the quality of our preparation,
            communication and documentation support.
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Privacy &amp; document handling</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            We treat your documents and personal information with care, and we use them to provide the service you
            asked for. Read our <a href="/privacy/" class="text-primary hover:underline">Privacy Policy</a>.
          </p>
        </section>

        <section>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Official sources</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            Requirements change. You can independently verify visa, study and registration rules on official
            government and embassy sites. We maintain an <a href="/official-links/" class="text-primary hover:underline">official links hub</a> to help you start.
          </p>
        </section>

        <BeforeYouPay embedded />

        <section>
          <h2 class="font-heading mb-4 text-2xl font-bold text-slate-900 dark:text-white">What we do promise</h2>
          <ul class="mb-8 grid gap-2 sm:grid-cols-2">
            {WE_PROMISE.map((item) => (
              <li class="flex gap-2 text-sm text-slate-700 dark:text-slate-300">
                <span class="text-primary" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <div class="rounded-md bg-slate-50 px-6 py-10 text-center dark:bg-slate-900">
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Contact</h2>
          <p class="mb-6 text-muted dark:text-slate-400">No pressure. No false promises. Just a clear conversation.</p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
            <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Chat on WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

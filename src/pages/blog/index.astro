---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListItem from '../../components/content/BlogListItem.astro';
import { publishedBlogs } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';
import { BLOG_TOPICS, coverImageFor, readingMinutesFromText, topicLabel } from '../../lib/article';

const items = await publishedBlogs();
const [featured, ...rest] = items;
---

<BaseLayout
  title={`Guides to help you make informed decisions | ${SITE.brandFull}`}
  description="Practical information about visas, education, international opportunities and business formation — written to help you understand what comes next."
  canonical="/blog/"
  page="blog"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ]),
    collectionPageSchema({
      name: `Guides to help you make informed decisions | ${SITE.brandFull}`,
      description: 'Practical information about visas, education, international opportunities and business formation.',
      url: absoluteUrl('/blog/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/blog/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="not-prose">
    <div class="mx-auto max-w-5xl px-4 py-10 text-center sm:px-6 md:py-12">
      <h1 class="mb-2 font-heading text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-white">
        The Blog
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-500 dark:text-slate-400">
        Practical information about visas, education, international opportunities and business formation — written to
        help you understand what comes next.
      </p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {BLOG_TOPICS.map((topic) => (
          <li>
            <span class="inline-flex rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {topic.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="mx-auto max-w-5xl space-y-10 px-4 pb-14 sm:px-6">
    {featured && (
      <BlogListItem
        featured
        href={`/blog/${featured.id}/`}
        title={featured.data.title}
        excerpt={featured.data.description}
        date={featured.data.publishDate}
        category={topicLabel(featured.data.category)}
        readingMinutes={featured.data.readingTime ?? readingMinutesFromText(featured.body)}
        image={coverImageFor({ image: featured.data.heroImage, cluster: 'blog', category: featured.data.category })}
        tags={featured.data.tags}
      />
    )}
    {rest.map((entry) => (
      <BlogListItem
        href={`/blog/${entry.id}/`}
        title={entry.data.title}
        excerpt={entry.data.description}
        date={entry.data.publishDate}
        category={topicLabel(entry.data.category)}
        readingMinutes={entry.data.readingTime ?? readingMinutesFromText(entry.body)}
        image={coverImageFor({ image: entry.data.heroImage, cluster: 'blog', category: entry.data.category })}
        tags={entry.data.tags}
      />
    ))}
  </section>
</BaseLayout>

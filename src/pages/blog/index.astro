---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedBlogs } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';
import { BLOG_TOPICS, readingMinutesFromText, topicLabel } from '../../lib/article';

const items = await publishedBlogs();
---

<BaseLayout
  title={`Guides to help you make informed decisions | ${SITE.brandFull}`}
  description="Practical information about visas, education, international opportunities and business formation — written to help you understand what comes next."
  canonical="/blog/"
  page="blog"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ]),
    collectionPageSchema({
      name: `Guides to help you make informed decisions | ${SITE.brandFull}`,
      description: 'Practical information about visas, education, international opportunities and business formation.',
      url: absoluteUrl('/blog/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/blog/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="not-prose border-b border-slate-200 bg-slate-50 py-10 dark:border-slate-800 dark:bg-dark-950 md:py-14">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="mb-2 text-base font-semibold uppercase tracking-wide text-primary dark:text-blue-400">Guides</p>
      <h1 class="mb-3 font-heading text-3xl font-bold text-slate-900 md:text-5xl dark:text-white">
        Guides to help you make informed decisions
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Practical information about visas, education, international opportunities and business formation — written to
        help you understand what comes next.
      </p>
    </div>
  </section>
  <section class="section-container not-prose">
    <ul class="mb-8 flex flex-wrap justify-center gap-2">
      {BLOG_TOPICS.map((topic) => (
        <li>
          <span class="inline-flex rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
            {topic.label}
          </span>
        </li>
      ))}
    </ul>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <ContentCard
          kind="blog"
          href={`/blog/${entry.id}/`}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={topicLabel(entry.data.category)}
          readingMinutes={entry.data.readingTime ?? readingMinutesFromText(entry.body)}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

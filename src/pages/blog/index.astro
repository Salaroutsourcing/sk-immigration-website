---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedBlogs } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';

const items = await publishedBlogs();
---

<BaseLayout
  title={`New visa guides | ${SITE.brandFull}`}
  description="Long-form visa guides with FAQs, official sources, and internal links. Web Stories and news feed this hub."
  canonical="/blog/"
  page="blog"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ]),
    collectionPageSchema({
      name: `New visa guides | ${SITE.brandFull}`,
      description: 'Long-form visa guides with FAQs, official sources, and internal links.',
      url: absoluteUrl('/blog/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/blog/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="platform-wrap">
    <p class="platform-kicker">Blog collection · 1 pillar / day target</p>
    <header class="platform-hero">
      <h1>Guides built to rank and convert</h1>
      <p class="lede">
        New MDX blogs publish here. Country guides already ranking at
        <a href="/blog.html">/blog.html</a> and <code>/blog/{'{country}'}/</code> stay exactly where they are.
      </p>
    </header>
    <div class="platform-grid">
      {items.map((entry) => (
        <ContentCard
          kind="blog"
          href={`/blog/${entry.id}/`}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

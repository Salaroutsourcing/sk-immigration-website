---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedBlogs } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';

const items = await publishedBlogs();
---

<BaseLayout
  title={`Visa guides & insights | ${SITE.brandFull}`}
  description="Long-form visa guides with FAQs, official sources, and internal links. Written for ranking, AI citation, and real decisions."
  canonical="/blog/"
  page="blog"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog/' },
    ]),
    collectionPageSchema({
      name: `Visa guides & insights | ${SITE.brandFull}`,
      description: 'Long-form visa guides with FAQs, official sources, and internal links.',
      url: absoluteUrl('/blog/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: `/blog/${entry.id}/`,
      })),
    }),
  ]}
>
  <section class="not-prose border-b border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-dark-950 md:py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-blue-400">Blog</p>
      <h1 class="mb-4 font-heading text-3xl font-bold text-slate-900 md:text-5xl dark:text-white">Guides built to rank and convert</h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Unique insight articles live here. Country landers stay on their service URLs — no duplicate Germany/UK/Canada posts.
      </p>
    </div>
  </section>
  <section class="section-container not-prose">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <ContentCard
          kind="blog"
          href={`/blog/${entry.id}/`}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

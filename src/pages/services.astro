---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { HOME_SERVICES } from '../lib/home';
import AuthoritySplit from '../components/home/AuthoritySplit.astro';
import ServiceCard from '../components/home/ServiceCard.astro';
import FinalCta from '../components/home/FinalCta.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
  ],
};
---

<BaseLayout
  title="Digital Immigration & Business Services — SK Immigration"
  description="Remote visa preparation, education pathways, document support, and international company registration. Clear scope, written fees, and no false guarantees."
  canonical="/services/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
        <p class="eyebrow">Services</p>
        <span class="accent-line mx-auto"></span>
        <h1 class="font-heading mt-3 text-3xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">
          Support for the journey you're planning
        </h1>
        <p class="mt-4 text-base leading-[1.65] text-muted sm:text-lg">
          Choose the service that matches your goal. Every service is delivered remotely with clear communication and
          defined scope.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {HOME_SERVICES.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6">
    <AuthoritySplit compact />
  </section>

  <FinalCta />
</BaseLayout>

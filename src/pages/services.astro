---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { HOME_SERVICES } from '../lib/home';
import AuthoritySplit from '../components/home/AuthoritySplit.astro';
import BeforeYouPay from '../components/home/BeforeYouPay.astro';
import FinalCta from '../components/home/FinalCta.astro';
import PageHero from '../components/ui/PageHero.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
  ],
};

const standard = HOME_SERVICES.filter((s) => !s.featured);
const featured = HOME_SERVICES.find((s) => s.featured);
---

<BaseLayout
  title="Digital Immigration & Business Services — SK Immigration"
  description="Remote visa preparation, education pathways, document support, and international company registration. Clear scope, written fees, and no false guarantees."
  canonical="/services/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <PageHero
    eyebrow="Services"
    title="Support for the journey you’re planning."
    text="Start with your goal. Every service is delivered remotely with a defined scope."
  />

  <section class="sk-wrap pb-16">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {standard.map((service) => (
        <a class="sk-card" href={service.href} id={service.id}>
          <h3>{service.title}</h3>
          {'badge' in service && service.badge && (
            <p class="mb-2 text-[0.7rem] font-bold uppercase tracking-[0.12em] text-gold">{service.badge}</p>
          )}
          <p>{service.description}</p>
          {'jobsDisclaimer' in service && service.jobsDisclaimer && (
            <p class="mt-3 text-xs font-semibold text-navy">{service.jobsDisclaimer}</p>
          )}
          <div class="sk-card-foot">
            <span class="text-xs font-semibold text-navy">{service.cta}</span>
            <span class="sk-card-arrow">→</span>
          </div>
        </a>
      ))}
    </div>

    {featured && (
      <article class="mt-6 grid overflow-hidden rounded-2xl border border-line bg-white lg:grid-cols-2" id={featured.id}>
        <div class="bg-canvas p-8 md:p-10">
          <p class="sk-eyebrow">International business</p>
          <h2 class="sk-h2 !text-3xl">{featured.headline}</h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft">{featured.description}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{featured.extra}</p>
        </div>
        <div class="p-8 md:p-10">
          <ul class="mb-6 grid gap-2 sm:grid-cols-2">
            {featured.benefits.map((item) => (
              <li class="flex items-start gap-2 text-sm text-ink">
                <span class="sk-dot mt-1.5"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          {'disclaimers' in featured && featured.disclaimers && (
            <p class="mb-6 text-xs leading-relaxed text-ink-soft">{featured.disclaimers[0]}</p>
          )}
          <a href={featured.href} class="btn-primary">{featured.cta}</a>
        </div>
      </article>
    )}
  </section>

  <AuthoritySplit compact />
  <div class="sk-wrap pb-4">
    <BeforeYouPay embedded />
  </div>
  <FinalCta />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
  ],
};

const services = [
  {
    id: 'study-visa',
    title: 'Study Visa & Admissions',
    badge: 'Higher Education',
    image: '/assets/services/student-visa.svg',
    alt: 'Study visa and admissions for Germany, UK, Canada, Italy, and Europe',
    description:
      'University shortlisting, SOP guidance, and visa file preparation for Germany, UK, Canada, Italy, Australia, and 15+ European destinations.',
    highlights: [
      'University and programme shortlisting',
      'SOP and motivation letter audit',
      'Blocked account and maintenance-fund guidance',
      'APS and document verification',
      'VFS/embassy appointment and interview coaching',
    ],
    ctaText: 'Open study visa page',
    ctaLink: '/study-visa/',
  },
  {
    id: 'work-permit',
    title: 'Germany Ausbildung & Work Permits',
    badge: 'Vocational Training · Paid',
    image: '/assets/services/ausbildung-work.svg',
    alt: 'Germany Ausbildung vocational training and work permits',
    description:
      'Paid vocational training placement and visa support for nursing, IT, hospitality, and technical trades with €600–€1,200/month training allowance.',
    highlights: [
      'Ausbildung employer matching',
      'Goethe B1/B2 language pathways',
      'National Visa (Type D) file compilation',
      'EU Opportunity Card (Chancenkarte)',
      'German CV (Lebenslauf) and cover letter',
    ],
    ctaText: 'Open work permit page',
    ctaLink: '/work-permit/',
  },
  {
    id: 'saudi-visa',
    title: 'Saudi Arabia Work Visa Processing',
    badge: 'Fixed PKR 15,000 Fee',
    image: '/assets/services/saudi-visa.svg',
    alt: 'Saudi Arabia work visa processing at a fixed fee',
    description:
      'End-to-end Saudi work visa processing at a fixed consultancy fee of PKR 15,000. Medical, stamping, and protector steps with written receipts.',
    highlights: [
      'GAMCA medical tracking',
      'Enjaz registration and embassy stamping',
      'Musaned domestic worker registration',
      'BEOE protector clearance',
      'Government fee receipts provided',
    ],
    ctaText: 'Open Saudi visa page',
    ctaLink: '/saudi-visa/saudi-visa-processing-pakistan/',
  },
  {
    id: 'visit-visa',
    title: 'Visit & Tourist Visas',
    badge: 'Tourism & Business',
    image: '/assets/services/visit-visa.svg',
    alt: 'Visit and tourist visas for UK, USA, Schengen, and Dubai',
    description:
      'Structured applications for UK Standard Visitor, US B1/B2, Schengen, Dubai, and Malaysia with financial and ties documentation.',
    highlights: [
      'Bank statement structuring',
      'Itineraries and hotel reservations',
      'Ties to home country evidence',
      'Purpose-of-travel cover letters',
      'VFS and embassy appointment coordination',
    ],
    ctaText: 'Open visit visa page',
    ctaLink: '/visit-visa/',
  },
  {
    id: 'attestation',
    title: 'Document Attestation Services',
    badge: 'Legal & Verification',
    image: '/assets/services/document-attestation.svg',
    alt: 'Document attestation MOFA HEC and Apostille services',
    description:
      'Authentication and legalisation across Pakistani educational and government bodies for study and work files.',
    highlights: [
      'MOFA attestation',
      'HEC degree verification',
      'Apostille for Hague countries',
      'Musadaqa and notary legalisations',
      'IBCC / QVP equivalence',
    ],
    ctaText: 'Open attestation page',
    ctaLink: '/document-services/',
  },
  {
    id: 'appointments',
    title: 'Visa Appointments & Interview Prep',
    badge: 'Submission Support',
    image: '/assets/services/visa-appointments.svg',
    alt: 'Visa appointments booking and interview coaching',
    description:
      'Slot monitoring across major facilitators and mock interview preparation before submission.',
    highlights: [
      'VFS, Gerry’s, TLS, and BLS monitoring',
      'Embassy direct portal scheduling',
      'Mock interview coaching',
      'Pre-submission file audit',
    ],
    ctaText: 'Open appointments page',
    ctaLink: '/visa-appointment/',
  },
];
---

<BaseLayout
  title="Immigration & Visa Services — SK Immigration Services Rawalpindi"
  description="Study visas, Germany Ausbildung, Saudi work visa processing (PKR 15,000 fixed), visit visas, document attestation, and visa appointments from Rawalpindi."
  canonical="/services/"
  jsonLd={breadcrumbSchema}
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="text-base font-semibold uppercase tracking-wide text-primary">Services</p>
        <h1 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          Immigration and visa file preparation
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          Honest guidance, written fees, and embassy-sourced checklists. Each card opens the full service page.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <article class="flex flex-col rounded-lg border border-gray-200 bg-white p-6 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900" id={service.id}>
            <div class="mb-4 flex items-center gap-4">
              <img src={service.image} alt="" class="h-12 w-12 rounded-md object-cover" width="48" height="48" loading="lazy" />
              <span class="text-xs font-bold uppercase tracking-wide text-primary">{service.badge}</span>
            </div>
            <h2 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">{service.title}</h2>
            <p class="mb-4 text-sm leading-relaxed text-muted dark:text-slate-400">{service.description}</p>
            <ul class="mb-6 flex-1 space-y-2 text-sm text-slate-700 dark:text-slate-300">
              {service.highlights.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 text-primary">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <a href={service.ctaLink} class="btn-primary w-full px-5 py-2.5 text-sm">{service.ctaText}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-container not-prose">
    <div class="mx-auto max-w-4xl rounded-md bg-slate-50 px-6 py-12 text-center dark:bg-slate-900 md:px-12 md:py-16">
      <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Not sure which pathway fits?
      </h2>
      <p class="mx-auto mb-6 max-w-2xl text-xl text-muted dark:text-slate-400">
        Book a free profile evaluation in Satellite Town, Rawalpindi.
      </p>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact/" class="btn-primary">Get started</a>
        <a href="/guides/" class="btn">Learn more</a>
      </div>
    </div>
  </section>
</BaseLayout>

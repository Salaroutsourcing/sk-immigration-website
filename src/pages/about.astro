---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, BUSINESS } from '../lib/config';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE.url}/about/` },
  ],
};
---

<BaseLayout
  title="About SK Immigration Services — Rawalpindi Pakistan"
  description="SK Immigration Services (SMC-Private) Limited, CUIN 0304985 — immigration consultancy in Rawalpindi. Honest guidance, transparent fees, no visa guarantees."
  canonical="/about/"
  jsonLd={breadcrumbSchema}
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-8 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="text-base font-semibold uppercase tracking-wide text-primary">About</p>
        <h1 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          File preparation from Rawalpindi
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          Honest assessments, written fees, and embassy-sourced checklists. Embassies decide every visa.
        </p>
      </div>

      <div class="grid items-start gap-10 lg:grid-cols-12">
        <div class="space-y-10 lg:col-span-8">
          <div>
            <h2 class="font-heading mb-4 text-2xl font-bold text-slate-900 dark:text-white">Our mission</h2>
            <p class="mb-4 leading-relaxed text-muted dark:text-slate-400">
              SK Immigration Services (also searched as SK Consultant) prepares study, work, visit, and Saudi files from Satellite Town, Rawalpindi. We were founded so applicants get accurate assessments based on real embassy rules — not sales pitches.
            </p>
            <p class="leading-relaxed text-muted dark:text-slate-400">
              We compile thorough files for universities and missions. Clients deserve facts: no consultant can guarantee an approval.
            </p>
          </div>

          <div>
            <p class="mb-2 text-base font-semibold uppercase tracking-wide text-primary">Features</p>
            <h2 class="font-heading mb-6 text-2xl font-bold text-slate-900 dark:text-white">How we work</h2>
            <div class="grid gap-6 sm:grid-cols-2">
              {[
                { title: 'Written fees', desc: 'Every service fee is confirmed in writing before you pay. No surprise add-ons.' },
                { title: 'Official checklists', desc: 'Document lists follow embassy, VFS, and government pages — not rumours.' },
                { title: 'Remote by default', desc: 'Services are delivered digitally. You can start an assessment or WhatsApp conversation from wherever you are.' },
                { title: 'No visa promises', desc: 'We prepare files and give honest guidance. Authorities make the decision.' },
              ].map((item) => (
                <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
                  <h3 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">{item.title}</h3>
                  <p class="text-sm leading-relaxed text-muted dark:text-slate-400">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside class="space-y-6 lg:col-span-4">
          <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="font-heading mb-4 text-lg font-bold text-slate-900 dark:text-white">Company details</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-muted">Legal name</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{SITE.legalName}</dd>
              </div>
              <div>
                <dt class="text-muted">Registration</dt>
                <dd class="font-medium text-slate-900 dark:text-white">CUIN {BUSINESS.cuin}</dd>
              </div>
              <div>
                <dt class="text-muted">Office</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{CONTACT.address.full}</dd>
              </div>
            </dl>
            <a
              href={BUSINESS.secpVerifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-block text-sm font-medium text-primary hover:underline"
            >
              Verify company on SECP LEAP ↗
            </a>
          </div>

          <div class="rounded-lg border border-gray-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="font-heading mb-3 text-lg font-bold text-slate-900 dark:text-white">Contact</h2>
            <address class="not-italic space-y-2 text-sm text-muted dark:text-slate-400">
              <p>
                <a href={`tel:${CONTACT.phone}`} class="hover:text-primary">{CONTACT.phoneFormatted}</a>
              </p>
              <p>
                <a href={`mailto:${CONTACT.email}`} class="hover:text-primary">{CONTACT.email}</a>
              </p>
              <p>{CONTACT.hours}</p>
            </address>
            <a href="/trust/" class="mb-3 inline-block text-sm font-medium text-primary hover:underline">Trust &amp; transparency →</a>
            <a href="/contact/" class="btn-primary mt-2 w-full px-5 py-2.5 text-sm">Start Assessment</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

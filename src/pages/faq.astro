---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { HOME_FAQS, ASSESSMENT_HREF } from '../lib/home';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE.url}/faq/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title="FAQ — SK Immigration"
  description="Honest answers about SK Immigration services: what we prepare, what authorities decide, online delivery, Saudi sponsor-driven processing, and company registration."
  canonical="/faq/"
  jsonLd={[breadcrumbSchema, faqSchema]}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="eyebrow">FAQ</p>
        <span class="accent-line mx-auto"></span>
        <h1 class="font-heading mt-3 mb-4 text-3xl font-bold tracking-tight text-ink sm:text-5xl dark:text-white">
          Clear answers, without the sales pitch.
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          We prepare, guide, organize and support. Authorities make the final decisions.
        </p>
      </div>

      <div class="mx-auto max-w-4xl divide-y divide-slate-200 dark:divide-slate-800">
        {HOME_FAQS.map((faq) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-medium text-slate-800 dark:text-slate-200">
              <span>{faq.q}</span>
              <span class="ml-4 text-primary transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted dark:text-slate-400">{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="mx-auto mt-12 max-w-3xl rounded-2xl bg-primary px-6 py-10 text-center text-white">
        <h2 class="font-heading mb-3 text-2xl font-bold text-white">Still have a question?</h2>
        <p class="mb-6 text-white/75">Tell us what you're planning. We'll help you understand the steps involved.</p>
        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
          <a href="/services/" class="btn border-white/30 text-white hover:bg-white hover:text-primary">Explore Services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

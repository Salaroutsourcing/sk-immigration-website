---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { ALL_FAQS, ASSESSMENT_HREF, WHATSAPP_HREF } from '../lib/home';
import PageHero from '../components/ui/PageHero.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE.url}/faq/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ALL_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout
  title="FAQ — SK Immigration"
  description="Honest answers about SK Immigration services: what we prepare, what authorities decide, online delivery, Saudi sponsor-driven processing, and company registration."
  canonical="/faq/"
  jsonLd={[breadcrumbSchema, faqSchema]}
  schemaVariant="global"
>
  <PageHero
    eyebrow="FAQ"
    title="Clear answers, without the sales pitch."
    text="We prepare, guide and support. Authorities make the final decisions."
  />
  <section class="sk-wrap max-w-3xl pb-8">
    <FaqAccordion faqs={ALL_FAQS} />
  </section>
  <section class="sk-wrap pb-20">
    <div class="rounded-2xl bg-canvas px-6 py-12 text-center">
      <h2 class="sk-h2 !text-2xl">Still have a question?</h2>
      <p class="mx-auto mt-3 max-w-lg text-ink-soft">Tell us what you’re planning. We’ll help you understand the next step.</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
        <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

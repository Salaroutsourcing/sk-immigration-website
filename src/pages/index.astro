---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import Identification from '../components/home/Identification.astro';
import ServiceGrid from '../components/home/ServiceGrid.astro';
import Process from '../components/home/Process.astro';
import Honesty from '../components/home/Honesty.astro';
import ClarityBlock from '../components/services/ClarityBlock.astro';
import CompanyFeature from '../components/home/CompanyFeature.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { HOME_FAQS } from '../lib/home';
import '../styles/services.css';
import '../styles/home.css';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout
  title="SK Immigration | Digital Immigration & Business Services"
  description="Online immigration, education, visa preparation and international company registration guidance. Clear processes, transparent service scope and no false guarantees."
  canonical="/"
  jsonLd={faqSchema}
  schemaVariant="global"
  keywords="SK Immigration, digital immigration services, study visa preparation, visit visa, company registration, Germany Ausbildung, document attestation"
  page="home"
>
  <div class="home-page">
    <Hero />
    <TrustStrip />
    <Identification />
    <ServiceGrid />
    <Process />
    <Honesty />
    <ClarityBlock />
    <CompanyFeature />
    <HomeFaq />
    <FinalCta />
  </div>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    const items = document.querySelectorAll('.reveal');
    items.forEach((el) => el.classList.add('is-pending'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove('is-pending');
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

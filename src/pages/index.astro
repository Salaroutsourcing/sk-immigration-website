---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import Identification from '../components/home/Identification.astro';
import EmotionalTrust from '../components/home/EmotionalTrust.astro';
import ServiceGrid from '../components/home/ServiceGrid.astro';
import Process from '../components/home/Process.astro';
import CompanyFeature from '../components/home/CompanyFeature.astro';
import Honesty from '../components/home/Honesty.astro';
import Audiences from '../components/home/Audiences.astro';
import GlobalReach from '../components/home/GlobalReach.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { HOME_FAQS } from '../lib/home';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout
  title="SK Immigration | Digital Immigration & Business Services"
  description="We help people prepare strong visa files, understand international pathways, and register companies with honesty, clarity, and care — completely online. Authorities make the final decisions."
  canonical="/"
  jsonLd={faqSchema}
  schemaVariant="global"
  keywords="SK Immigration, digital immigration services, study visa preparation, visit visa, company registration, Germany Ausbildung, document attestation"
>
  <Hero />
  <TrustStrip />
  <Identification />
  <EmotionalTrust />
  <ServiceGrid />
  <Process />
  <CompanyFeature />
  <Honesty />
  <Audiences />
  <GlobalReach />
  <FinalCta />
</BaseLayout>

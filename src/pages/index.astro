---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { CONTACT, BUSINESS, SERVICE_HUBS } from '../lib/config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is SK Consultant / SK Immigration Services?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration Services (also searched as SK Consultant) is the public brand of SK Immigration Services (SMC-Private) Limited, CUIN 0304985, based in Satellite Town, Rawalpindi. Website: https://immigration.salaroutsourcing.com. Official WhatsApp: +92 304 5999859.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the official SK Immigration phone number?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The official phone and WhatsApp number is +92 304 5999859. Match any Google Business listing to this number before you call or pay any fees.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does SK Immigration Services guarantee visas?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. SK Immigration Services does not sell visa guarantees and never will. Embassies, VFS Global centres, and immigration authorities make every final visa decision.',
      },
    },
    {
      '@type': 'Question',
      name: 'What services does SK Immigration offer from Pakistan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration prepares: Germany study visa & Ausbildung, UK student visa, Canada study permit, Italy & Australia study visas, Saudi Arabia work visa processing (fixed fee PKR 15,000), UAE/Schengen visit visas, document attestation, and visa appointment booking.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is SK Immigration Services SECP registered?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. SK Immigration Services (SMC-Private) Limited is registered with the Securities and Exchange Commission of Pakistan (SECP), CUIN 0304985. Verify at leap.secp.gov.pk.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does SK Immigration charge for Saudi work visa processing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration charges a fixed fee of PKR 15,000 for complete Saudi Arabia work visa processing including medical clearance, Enjaz registration, visa stamping, Musaned registration, and protector/BEOE departure formalities.',
      },
    },
  ],
};
---

<BaseLayout canonical="/" jsonLd={faqSchema}>
  <section class="not-prose relative bg-gradient-to-b from-slate-50 via-white to-slate-50 dark:from-dark-950 dark:via-slate-950 dark:to-dark-950">
    <div class="relative mx-auto max-w-7xl px-4 py-14 text-center sm:px-6 md:py-24">
      <div class="mb-6 inline-flex items-center gap-x-2 rounded-full border border-blue-100 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-primary-700 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-blue-300">
        <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
        SK Immigration Services (SMC-Private) Limited · SECP CUIN {BUSINESS.cuin}
      </div>
      <h1 class="mx-auto mb-6 max-w-4xl font-heading text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl md:text-6xl dark:text-white">
        Pakistan's SECP-Registered Immigration &amp; Visa Advisory
      </h1>
      <p class="mx-auto mb-8 max-w-3xl text-lg leading-relaxed text-slate-600 md:text-xl dark:text-slate-400">
        Professional file preparation, university admissions, and visa appointments for Germany, UK, Canada, and Saudi Arabia.
        <span class="font-semibold text-slate-800 dark:text-slate-200"> Transparent fees, a walk-in office in Rawalpindi, and honest guidance.</span>
      </p>
      <div class="mx-auto flex max-w-md flex-col gap-4 sm:flex-row sm:justify-center">
        <a class="btn-primary w-full shadow-md sm:w-auto" href="/contact/">Book Free Consultation</a>
        <a class="btn-whatsapp flex w-full items-center justify-center gap-2 shadow-md sm:w-auto" href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer">
          WhatsApp {CONTACT.phoneFormatted}
        </a>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-slate-600 md:gap-8 dark:text-slate-400">
        <span>SECP Verified (CUIN 0304985)</span>
        <span>Satellite Town Rawalpindi Office</span>
        <span>No Visa Guarantees Policy</span>
      </div>
    </div>
  </section>

  <section class="not-prose border-y border-blue-100 bg-blue-50/80 dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-5 text-center text-sm font-medium md:text-base sm:px-6">
      <span class="font-bold text-primary-800 dark:text-blue-300">Our Honest Standard:</span>
      <span class="text-slate-700 dark:text-slate-300">
        {' '}We compile genuine files aligned with official consulate standards. Embassies decide every visa outcome — we never make misleading promises.
      </span>
    </div>
  </section>

  <section class="section-container not-prose" id="hubs">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-blue-400">Services</p>
      <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">
        Choose your pathway
      </h2>
      <p class="text-base text-slate-600 md:text-lg dark:text-slate-400">
        Each card opens the full service page — requirements, documents, and how we help.
      </p>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICE_HUBS.map((hub) => (
        <a
          href={hub.href}
          class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-md transition duration-300 hover:-translate-y-1.5 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="relative aspect-square w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img src={hub.image} alt={hub.alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" width="500" height="500" />
            <div class="absolute left-4 top-4">
              <span class="inline-flex items-center rounded-full border border-slate-200/60 bg-white/95 px-3 py-1 text-xs font-bold text-slate-900 shadow-sm backdrop-blur-md dark:border-slate-700/60 dark:bg-dark-950/90 dark:text-white">
                {hub.badge}
              </span>
            </div>
          </div>
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <h3 class="mb-2 font-heading text-xl font-bold text-slate-900 transition group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                {hub.title}
              </h3>
              <p class="mb-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{hub.description}</p>
            </div>
            <div>
              <div class="mb-4 flex flex-wrap gap-1.5 border-t border-slate-100 pt-3 dark:border-slate-800">
                {hub.tags.map((tag) => (
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400">{tag}</span>
                ))}
              </div>
              <div class="flex items-center justify-between text-xs font-bold text-primary-600 dark:text-primary-400">
                <span>Open service page</span>
                <span class="transition group-hover:translate-x-1">→</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="not-prose border-y border-slate-200/80 bg-slate-50 dark:border-slate-800 dark:bg-dark-950">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid grid-cols-2 gap-8 text-center md:grid-cols-4">
        <div>
          <div class="mb-1.5 font-heading text-3xl font-bold text-primary-600 sm:text-4xl dark:text-blue-400">0304985</div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 sm:text-sm dark:text-slate-400">SECP CUIN</p>
        </div>
        <div>
          <div class="mb-1.5 font-heading text-3xl font-bold text-primary-600 sm:text-4xl dark:text-blue-400">100%</div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 sm:text-sm dark:text-slate-400">Honest Advice</p>
        </div>
        <div>
          <div class="mb-1.5 font-heading text-3xl font-bold text-primary-600 sm:text-4xl dark:text-blue-400">5,000+</div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 sm:text-sm dark:text-slate-400">Files Evaluated</p>
        </div>
        <div>
          <div class="mb-1.5 font-heading text-3xl font-bold text-primary-600 sm:text-4xl dark:text-blue-400">24 Hours</div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 sm:text-sm dark:text-slate-400">Fast Response</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-container not-prose">
    <div class="grid items-start gap-10 md:grid-cols-2 lg:gap-16">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-blue-400">Structured Methodology</p>
        <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">
          Our 4-step file preparation process
        </h2>
        <p class="mb-8 text-base leading-relaxed text-slate-600 dark:text-slate-400">
          We follow an official, transparent roadmap for every client file.
        </p>
        <div class="space-y-6">
          {[
            { step: '1', title: 'Free Profile Assessment', desc: 'We evaluate transcripts, language scores, and finances before you pay any fees.' },
            { step: '2', title: 'Embassy Document Compilation', desc: 'Checklists match official embassy directives — SOP, blocked accounts, MOFA attestations.' },
            { step: '3', title: 'Submission & Interview Prep', desc: 'Appointment booking at VFS, Gerry’s, or embassy portals, plus mock interview coaching.' },
            { step: '4', title: 'Pre-Departure Clearance', desc: 'Visa stamping checks, BEOE protector, and arrival guidance.' },
          ].map((item) => (
            <div class="flex">
              <div class="mr-4 flex flex-col items-center">
                <div class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-primary-600 bg-primary-50 text-sm font-bold text-primary-700 dark:bg-slate-800 dark:text-blue-300">
                  {item.step}
                </div>
                <div class="mt-2 h-full w-px bg-slate-200 dark:bg-slate-700"></div>
              </div>
              <div class="pb-4 pt-1">
                <h3 class="mb-1 font-heading text-base font-bold text-slate-900 dark:text-white">{item.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="rounded-3xl border border-slate-200/90 bg-slate-50 p-7 shadow-sm md:p-8 dark:border-slate-800 dark:bg-slate-900">
        <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-primary-700 dark:bg-slate-800 dark:text-blue-300">
          Institutional Security
        </div>
        <h3 class="mb-4 font-heading text-xl font-bold text-slate-900 dark:text-white">The SK Immigration Standard</h3>
        <ul class="space-y-4 text-sm text-slate-700 dark:text-slate-300">
          <li class="flex items-start gap-3"><span class="text-base font-bold text-emerald-600">✓</span><div><strong>Official SECP Incorporation:</strong> SK Immigration Services (SMC-Private) Limited, CUIN 0304985.</div></li>
          <li class="flex items-start gap-3"><span class="text-base font-bold text-emerald-600">✓</span><div><strong>100% Honest Policy:</strong> Embassies hold exclusive visa authority — we never sell fake guarantees.</div></li>
          <li class="flex items-start gap-3"><span class="text-base font-bold text-emerald-600">✓</span><div><strong>Transparent Written Pricing:</strong> Saudi work visa at PKR 15,000 fixed. No hidden processing expenses.</div></li>
          <li class="flex items-start gap-3"><span class="text-base font-bold text-emerald-600">✓</span><div><strong>Physical Walk-In Office:</strong> Office No. 10, Alfazal Plaza 64C, Satellite Town, Rawalpindi.</div></li>
        </ul>
        <div class="mt-8 flex justify-center border-t border-slate-200 pt-6 dark:border-slate-800">
          <a href={BUSINESS.secpVerifyUrl} target="_blank" rel="noopener noreferrer" class="btn-tertiary px-5 py-2 text-xs">
            Verify on SECP LEAP ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <AdSlot slotId="1122334455" format="horizontal" />
  </div>

  <section class="not-prose border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-dark-950">
    <div class="section-container">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-blue-400">Frequently Asked Questions</p>
        <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">Clear answers</h2>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {[
          { q: 'Who is SK Consultant / SK Immigration Services?', a: 'SK Immigration Services is the public brand of SK Immigration Services (SMC-Private) Limited, CUIN 0304985, based in Satellite Town, Rawalpindi.' },
          { q: 'What is the official phone number?', a: 'The only official phone and WhatsApp number is +92 304 5999859. Verify any listing against this number before paying.' },
          { q: 'Does SK Immigration guarantee visa approval?', a: 'No. Embassies and consulates make every final visa decision. We provide file preparation and honest guidance.' },
          { q: 'What is the cost for Saudi work visa processing?', a: 'Fixed consultancy fee of PKR 15,000 for complete Saudi work visa processing (medical, Enjaz, Musaned, and protector).' },
          { q: 'Do you offer free profile assessments?', a: 'Yes. Your initial consultation and eligibility assessment are free with zero obligation.' },
          { q: 'How can I verify SECP registration?', a: 'Go to leap.secp.gov.pk, click Verify Company Information, and search for SK Immigration Services (CUIN 0304985).' },
        ].map((faq) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <h3 class="mb-2 font-heading text-base font-bold text-slate-900 dark:text-white">{faq.q}</h3>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-container not-prose">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-gradient-to-r from-primary-900 via-primary-800 to-dark-900 p-8 text-center text-white shadow-xl md:p-12">
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">Ready to discuss your visa file?</h2>
      <p class="mx-auto mb-8 max-w-3xl text-sm leading-relaxed text-slate-300 md:text-base">
        Book a free consultation. We review your academic, financial, and visa profile with complete honesty.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/contact/" class="btn-primary bg-white font-bold text-primary-900 shadow-none hover:bg-slate-100">Book Free Consultation</a>
        <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">WhatsApp {CONTACT.phoneFormatted}</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SERVICE_HUBS } from '../lib/config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is SK Consultant / SK Immigration Services?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration Services (also searched as SK Consultant) is the public brand of SK Immigration Services (SMC-Private) Limited, CUIN 0304985, based in Satellite Town, Rawalpindi. Website: https://immigration.salaroutsourcing.com. Official WhatsApp: +92 304 5999859.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the official SK Immigration phone number?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The official phone and WhatsApp number is +92 304 5999859. Match any Google Business listing to this number before you call or pay any fees.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does SK Immigration Services guarantee visas?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. SK Immigration Services does not sell visa guarantees and never will. Embassies, VFS Global centres, and immigration authorities make every final visa decision.',
      },
    },
    {
      '@type': 'Question',
      name: 'What services does SK Immigration offer from Pakistan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration prepares: Germany study visa & Ausbildung, UK student visa, Canada study permit, Italy & Australia study visas, Saudi Arabia work visa processing (fixed fee PKR 15,000), UAE/Schengen visit visas, document attestation, and visa appointment booking.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is SK Immigration Services SECP registered?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. SK Immigration Services (SMC-Private) Limited is registered with the Securities and Exchange Commission of Pakistan (SECP), CUIN 0304985. Verify at leap.secp.gov.pk. Company details: https://immigration.salaroutsourcing.com/about/.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does SK Immigration charge for Saudi work visa processing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SK Immigration charges a fixed fee of PKR 15,000 for complete Saudi Arabia work visa processing including medical clearance, Enjaz registration, visa stamping, Musaned registration, and protector/BEOE departure formalities.',
      },
    },
  ],
};

const visibleFaqs = [
  { q: 'Do you guarantee visa approval?', a: 'No. Embassies and consulates make every final visa decision. We prepare files and give honest guidance.' },
  { q: 'What is the official phone number?', a: 'WhatsApp and phone: +92 304 5999859. Match any listing against this number before you pay.' },
  { q: 'Is the first consultation free?', a: 'Yes. Your first profile assessment is free, with no obligation to hire us afterwards.' },
  { q: 'What does Saudi work visa processing cost?', a: 'Fixed consultancy fee of PKR 15,000 for complete processing (medical, Enjaz, Musaned, protector). Authority fees are separate.' },
  { q: 'Where is the office?', a: 'Office No. 10, Alfazal Plaza 64C, Satellite Town, Rawalpindi. Monday–Saturday, 10:00–19:00.' },
  { q: 'Which services do you offer?', a: 'Study visas, Germany Ausbildung, work permits, visit visas, Saudi work processing, document attestation, and appointment support.' },
];
---

<BaseLayout canonical="/" jsonLd={faqSchema}>
  <section class="not-prose relative md:-mt-[76px] md:pt-[76px]">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-base font-bold tracking-wide text-primary dark:text-blue-200">Study · Work · Visit</p>
        <h1 class="font-heading mb-6 text-4xl font-bold leading-tighter tracking-tighter text-slate-900 sm:text-5xl md:text-6xl dark:text-white">
          Visa file preparation from Pakistan —{' '}
          <span class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent highlight">honest guidance</span>
        </h1>
        <p class="mx-auto mb-8 max-w-3xl text-xl text-muted dark:text-slate-400">
          University admissions, work permits, visit visas, and Saudi processing from our Rawalpindi office.
          Transparent fees. Embassies decide every outcome.
        </p>
        <div class="flex max-w-xs sm:max-w-md mx-auto flex-col gap-4 sm:flex-row sm:justify-center">
          <a class="btn-primary w-full sm:mb-0 sm:w-auto" href="/contact/">Get started</a>
          <a class="btn w-full sm:w-auto" href="/services/">Learn more</a>
        </div>
      </div>
    </div>
  </section>

  <section class="not-prose">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-center text-sm italic text-muted">
        <span class="font-semibold text-slate-700 dark:text-slate-200">Our standard:</span>
        we compile genuine files from official checklists. We never sell visa promises.
      </p>
    </div>
  </section>

  <section class="section-container not-prose" id="hubs">
    <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
      <p class="text-base text-primary font-semibold tracking-wide uppercase">Features</p>
      <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        What you get with SK Immigration
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Each card opens a full service page — requirements, documents, and how we help.
      </p>
    </div>
    <div class="mx-auto grid max-w-7xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICE_HUBS.map((hub) => (
        <a
          href={hub.href}
          class="rounded-lg border border-gray-200 bg-white p-6 shadow-none transition hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
        >
          <div class="mb-4 flex items-center gap-4">
            <img src={hub.image} alt="" class="h-12 w-12 rounded-md object-cover" width="48" height="48" loading="lazy" />
            <span class="text-xs font-bold uppercase tracking-wide text-primary">{hub.badge}</span>
          </div>
          <h3 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">{hub.title}</h3>
          <p class="text-muted text-sm leading-relaxed dark:text-slate-400">{hub.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="not-prose">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid grid-cols-2 gap-8 text-center md:grid-cols-4">
        <div>
          <div class="font-heading text-4xl font-bold text-primary lg:text-5xl">5,000+</div>
          <p class="mt-2 text-sm font-medium uppercase tracking-widest text-muted">Files reviewed</p>
        </div>
        <div>
          <div class="font-heading text-4xl font-bold text-primary lg:text-5xl">20+</div>
          <p class="mt-2 text-sm font-medium uppercase tracking-widest text-muted">Destinations</p>
        </div>
        <div>
          <div class="font-heading text-4xl font-bold text-primary lg:text-5xl">PKR 15k</div>
          <p class="mt-2 text-sm font-medium uppercase tracking-widest text-muted">Saudi package</p>
        </div>
        <div>
          <div class="font-heading text-4xl font-bold text-primary lg:text-5xl">24h</div>
          <p class="mt-2 text-sm font-medium uppercase tracking-widest text-muted">First reply</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-container not-prose">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center md:mx-auto md:mb-12 max-w-3xl">
        <p class="text-base text-primary font-semibold tracking-wide uppercase">Inside the process</p>
        <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          Four steps to a complete file
        </h2>
      </div>
      <ol class="space-y-8">
        {[
          { step: '1', title: 'Free profile assessment', desc: 'We review transcripts, language scores, and finances before you pay any fees.' },
          { step: '2', title: 'Document compilation', desc: 'Checklists follow official embassy pages — SOP, funds, attestation, and appointments.' },
          { step: '3', title: 'Submission & interview prep', desc: 'VFS, Gerry’s, or embassy booking, plus mock interview coaching where it helps.' },
          { step: '4', title: 'Pre-departure checks', desc: 'Stamping review, protector/BEOE guidance, and arrival notes when you need them.' },
        ].map((item) => (
          <li class="flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-white">
              {item.step}
            </div>
            <div>
              <h3 class="mb-1 text-xl font-medium leading-6 text-slate-900 dark:text-white">{item.title}</h3>
              <p class="text-muted dark:text-slate-400">{item.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <AdSlot slotId="1122334455" format="horizontal" />
  </div>

  <section class="section-container not-prose">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center">
        <p class="text-base text-primary font-semibold tracking-wide uppercase">FAQs</p>
        <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          Frequently asked questions
        </h2>
      </div>
      <div class="divide-y divide-slate-200 dark:divide-slate-800">
        {visibleFaqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-medium text-slate-800 dark:text-slate-200">
              <span>{faq.q}</span>
              <span class="ml-4 text-primary transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted dark:text-slate-400">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-container not-prose">
    <div class="mx-auto max-w-4xl rounded-md bg-slate-50 px-6 py-12 text-center dark:bg-slate-900 md:px-12 md:py-16">
      <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Ready to start your visa file?
      </h2>
      <p class="mx-auto mb-6 max-w-2xl text-xl text-muted dark:text-slate-400">
        Book a free consultation. We review your academic, financial, and visa profile with complete honesty.
      </p>
      <a href="/contact/" class="btn-primary">Get started</a>
    </div>
  </section>
</BaseLayout>

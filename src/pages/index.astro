---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import EditorialNote from '../components/home/EditorialNote.astro';
import ServiceSelector from '../components/home/ServiceSelector.astro';
import ProcessTimeline from '../components/home/ProcessTimeline.astro';
import WhySk from '../components/home/WhySk.astro';
import TrustGrid from '../components/home/TrustGrid.astro';
import RoleComparison from '../components/home/RoleComparison.astro';
import HonestyBanner from '../components/home/HonestyBanner.astro';
import CompanySection from '../components/home/CompanySection.astro';
import GuidesPreview from '../components/home/GuidesPreview.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { HOME_FAQS } from '../lib/home';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout
  title="SK Immigration | Digital Immigration & Business Services"
  description="Online immigration, education, visa preparation and international company registration guidance. Clear processes, transparent service scope and no false guarantees."
  canonical="/"
  jsonLd={faqSchema}
  schemaVariant="global"
  keywords="SK Immigration, digital immigration services, study visa preparation, visit visa, company registration, Germany Ausbildung, document attestation"
  page="home"
>
  <Hero />
  <EditorialNote />
  <ServiceSelector />
  <ProcessTimeline />
  <WhySk />
  <TrustGrid />
  <RoleComparison />
  <HonestyBanner />
  <CompanySection />
  <GuidesPreview />
  <HomeFaq />
  <FinalCta />
</BaseLayout>

---
import ToolLayout from '../layouts/ToolLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SK Immigration Eligibility Quiz',
  url: 'https://immigration.salaroutsourcing.com/eligibility/',
  applicationCategory: 'BusinessApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
};
---

<ToolLayout
  title="Find your starting point | SK Immigration"
  description="Answer a few questions and find the SK Immigration service or guide most relevant to your goal. Guidance only — authorities decide outcomes."
  canonical="/eligibility/"
  jsonLd={jsonLd}
>
  <section class="not-prose">
    <div class="page-intro">
      <p class="eyebrow">Free tool · ~60 seconds</p>
      <span class="accent-line mx-auto"></span>
      <h1 class="font-heading mt-3 mb-4 text-3xl font-bold tracking-tight text-ink md:text-5xl dark:text-white">
        Not sure where to start?
      </h1>
      <p class="text-base leading-[1.65] text-muted">
        Answer a few questions and find the SK Immigration service or guide most relevant to your goal. This is
        guidance only — authorities make the final decisions.
      </p>
    </div>
  </section>
  <section class="section-container tool-shell">
    <div class="mx-auto max-w-3xl">
      <div id="quizRoot"></div>
      <div class="prose prose-slate mt-10 max-w-none dark:prose-invert">
        <h2>What this eligibility quiz checks</h2>
        <p>
          The quiz helps you shortlist realistic study or training pathways before a conversation with us. It is
          guidance only — embassies and universities decide outcomes.
        </p>
        <ul>
          <li>Education level and marks profile</li>
          <li>Budget and preferred region (Europe, UK, Canada, Gulf, and more)</li>
          <li>Language readiness (IELTS / German / other)</li>
          <li>Timeline and whether Ausbildung or degree routes fit better</li>
        </ul>
        <h2>After your result</h2>
        <ol>
          <li>Open the matching <a href="/study-visa/">study visa</a> or <a href="/work-permit/">work permit</a> country guide.</li>
          <li>Tick documents on the <a href="/checklist/">checklist</a>.</li>
          <li>Book a conversation via <a href="/contact/">assessment</a> or WhatsApp.</li>
        </ol>
        <p>
          Prefer reading first? See <a href="/guides/study-abroad-without-ielts-pakistan/">study without IELTS</a>,
          <a href="/guides/germany-student-visa-ausbildung/">Ausbildung Pakistan</a>, and the
          <a href="/answers/">Answers hub</a>.
        </p>
      </div>
      <AdSlot slotId="1122334455" format="horizontal" />
    </div>
  </section>
  <Fragment slot="scripts">
    <script is:inline src="/assets/js/config.js"></script>
    <script is:inline src="/assets/js/api.js"></script>
    <script is:inline src="/assets/js/quiz.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => window.SalarQuiz && window.SalarQuiz.mount('#quizRoot'));
    </script>
  </Fragment>
</ToolLayout>

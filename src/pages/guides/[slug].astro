---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import LanderLayout from '../../layouts/LanderLayout.astro';
import { SITE } from '../../lib/site';
import { basePageGraph } from '../../lib/seo';
import type { CollectionEntry } from 'astro:content';
import { landerPath } from '../../lib/landers';
import {
  headingsFromMarkdown,
  officialSourcesFor,
  readingMinutesFromText,
  relatedServicesFor,
} from '../../lib/article';

export async function getStaticPaths() {
  const skipJsonGuides = new Set(['ausbildung-pakistan']);
  const markdown = await getCollection('guides');
  const json = await getCollection(
    'landers',
    (entry) => entry.data.cluster === 'guides' && !skipJsonGuides.has(entry.data.slug),
  );
  const markdownIds = new Set(markdown.map((guide) => guide.id));
  return [
    ...markdown.map((guide) => ({
      params: { slug: guide.id },
      props: { kind: 'md' as const, guide },
    })),
    ...json
      .filter((entry) => !markdownIds.has(entry.data.slug))
      .map((entry) => ({
        params: { slug: entry.data.slug },
        props: { kind: 'json' as const, entry },
      })),
  ];
}

interface Props {
  kind: 'md' | 'json';
  guide?: CollectionEntry<'guides'>;
  entry?: CollectionEntry<'landers'>;
}

const { kind, guide, entry } = Astro.props as Props;
const rendered = kind === 'md' && guide ? await render(guide) : null;
const Content = rendered?.Content;
const path = guide ? `/guides/${guide.id}/` : '';
const toc = guide ? headingsFromMarkdown(guide.body) : [];
const readingMinutes = guide ? readingMinutesFromText(guide.body) : undefined;
const relatedGuides = guide
  ? [
      ...(await getCollection('guides'))
        .filter((item) => item.id !== guide.id)
        .map((item) => ({
          href: `/guides/${item.id}/`,
          title: item.data.title,
          category: item.data.country,
          description: item.data.description,
        })),
      ...(await getCollection(
        'landers',
        (entry) =>
          (entry.data.cluster === 'study-visa' || entry.data.cluster === 'work-permit') &&
          entry.data.slug.toLowerCase().includes(guide.data.country.toLowerCase().split(' ')[0]),
      ))
        .slice(0, 3)
        .map((item) => ({
          href: landerPath(item),
          title: item.data.h1,
          category: item.data.cluster.replace(/-/g, ' '),
          description: item.data.description,
        })),
    ].slice(0, 4)
  : [];
---

{kind === 'json' && entry && <LanderLayout entry={entry} />}

{kind === 'md' && guide && Content && (
  <ArticleLayout
    title={`${guide.data.title} | ${SITE.brand}`}
    description={guide.data.description}
    canonical={path}
    published={guide.data.publishDate}
    updated={guide.data.updatedDate}
    image={guide.data.heroImage ?? guide.data.ogImage}
    page="guides"
    category={guide.data.visaType}
    crumbs={[
      { name: 'Home', path: '/' },
      { name: 'Guides', path: '/guides/' },
      { name: guide.data.title, path },
    ]}
    faqs={guide.data.faqs}
    toc={toc}
    readingMinutes={readingMinutes}
    relatedItems={relatedGuides}
    relatedServices={relatedServicesFor('guides')}
    officialSources={officialSourcesFor('guides')}
    country={guide.data.country}
    jsonLd={[
      ...basePageGraph([
        { name: 'Home', path: '/' },
        { name: 'Guides', path: '/guides/' },
        { name: guide.data.title, path },
      ]),
    ]}
  >
    <Content />
  </ArticleLayout>
)}

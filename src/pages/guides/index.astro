---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListItem from '../../components/content/BlogListItem.astro';
import { getCollection } from 'astro:content';
import { SERVICE_HUBS } from '../../lib/config';
import { landerPath } from '../../lib/landers';
import { coverImageFor, readingMinutesFromText } from '../../lib/article';

const SKIP_JSON_GUIDES = new Set(['ausbildung-pakistan']);

const markdown = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const jsonGuides = (
  await getCollection(
    'landers',
    (entry) => entry.data.cluster === 'guides' && !SKIP_JSON_GUIDES.has(entry.data.slug),
  )
).sort((a, b) => a.data.h1.localeCompare(b.data.h1));

const items = [
  ...markdown.map((guide) => ({
    href: `/guides/${guide.id}/`,
    title: guide.data.title,
    excerpt: guide.data.description,
    date: guide.data.publishDate,
    category: guide.data.country,
    readingMinutes: readingMinutesFromText(guide.body),
    image: coverImageFor({ image: guide.data.heroImage, cluster: 'guides' }),
    tags: guide.data.tags,
  })),
  ...jsonGuides.map((entry) => ({
    href: landerPath(entry),
    title: entry.data.h1,
    excerpt: entry.data.description,
    date: entry.data.publishDate,
    category: 'How-to',
    readingMinutes: readingMinutesFromText(entry.data.body),
    image: coverImageFor({ image: entry.data.image, cluster: 'guides' }),
    tags: [] as string[],
  })),
];
const [featured, ...rest] = items;
---

<BaseLayout
  title="Country & visa guides — SK Immigration"
  description="Practical country and visa guides to help you understand requirements, documents, process and what can change — so you can verify official sources before you apply."
  canonical="/guides/"
>
  <section class="not-prose">
    <div class="mx-auto max-w-5xl px-4 py-10 text-center sm:px-6 md:py-12">
      <h1 class="mb-2 font-heading text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-white">
        Guides
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-slate-500 dark:text-slate-400">
        Practical information about visas, education, international opportunities and business formation — written to
        help you understand what comes next.
      </p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {SERVICE_HUBS.map((hub) => (
          <li>
            <a
              href={hub.href}
              class="inline-flex rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300"
            >
              {hub.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="mx-auto max-w-5xl space-y-10 px-4 pb-14 sm:px-6">
    {featured && <BlogListItem featured {...featured} />}
    {rest.map((item) => (
      <BlogListItem {...item} />
    ))}
  </section>
</BaseLayout>

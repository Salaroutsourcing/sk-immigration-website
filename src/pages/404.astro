---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested is not on the SK Immigration Services website." canonical="/404/" noindex>
  <section class="section-container text-center">
    <p class="mb-2 text-base font-semibold uppercase tracking-wide text-primary">404</p>
    <h1 class="font-heading mb-4 text-4xl font-bold tracking-tight text-slate-900 dark:text-white">This page is not available</h1>
    <p class="mx-auto mb-8 max-w-lg text-xl text-muted dark:text-slate-400">
      The link may be old. Use the homepage or browse services.
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/contact/" class="btn-primary">Start My Assessment</a>
      <a href="/services/" class="btn">Explore Services</a>
    </div>
  </section>
</BaseLayout>

---
import ToolLayout from '../layouts/ToolLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SK Immigration Study Cost Calculator',
  url: 'https://immigration.salaroutsourcing.com/calculator/',
  applicationCategory: 'FinanceApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
};
---

<ToolLayout
  title="Study Abroad Cost Calculator | 20 Countries"
  description="Estimate yearly study costs for Germany, UK, Canada, Hungary, Poland and 15 more destinations. Visual ranges from SK Immigration Services — free consult for a personal budget."
  canonical="/calculator/"
  jsonLd={jsonLd}
>
  <section class="not-prose border-b border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-dark-950 md:py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-primary-600">Free tool · Visual budgets</p>
      <h1 class="mb-4 font-heading text-3xl font-bold text-slate-900 md:text-5xl dark:text-white">How much will it really cost?</h1>
      <p class="text-lg text-slate-600 dark:text-slate-400">
        Pick a country. See low / typical / high yearly bands for tuition + living. Then open the matching document checklist.
      </p>
    </div>
  </section>
  <section class="section-container tool-shell">
    <div class="mx-auto max-w-3xl">
      <div id="calcRoot"></div>
      <AdSlot slotId="1122334455" format="horizontal" />
    </div>
  </section>
  <Fragment slot="scripts">
    <script is:inline src="/assets/js/config.js"></script>
    <script is:inline src="/assets/js/api.js"></script>
    <script is:inline src="/assets/js/visa-tools.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => window.SalarTools && window.SalarTools.mountCalculator('#calcRoot'));
    </script>
  </Fragment>
</ToolLayout>

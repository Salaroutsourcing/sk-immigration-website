---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { ASSESSMENT_HREF, HOW_IT_WORKS_HREF, HOME_SERVICES } from '../lib/home';

const company = HOME_SERVICES.find((s) => s.id === 'company')!;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Business Registration', item: `${SITE.url}/business-registration/` },
  ],
};
---

<BaseLayout
  title="Company & Business Registration — SK Immigration"
  description="Remote company formation and documentation support for entrepreneurs planning to establish or expand internationally. We explain the process; authorities make the final decisions."
  canonical="/business-registration/"
  jsonLd={breadcrumbSchema}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="text-base font-semibold uppercase tracking-wide text-primary">Company Registration</p>
        <h1 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          Build your business internationally.
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          Company Formation • Documentation • International Expansion
        </p>
      </div>

      <div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-7">
          <p class="text-lg leading-relaxed text-muted dark:text-slate-400">{company.description}</p>
          <p class="text-lg leading-relaxed text-muted dark:text-slate-400">{company.extra}</p>
          <p class="text-sm font-semibold tracking-wide text-slate-800 dark:text-slate-200">
            {company.markets?.join(' · ')}
          </p>
          <ul class="grid gap-3 sm:grid-cols-2">
            {company.benefits.map((item) => (
              <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                <span class="mt-0.5 text-primary" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="space-y-3 rounded-lg border border-gray-200 bg-slate-50 p-5 text-sm leading-relaxed text-muted dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
            {company.disclaimers?.map((d) => (
              <p>{d}</p>
            ))}
          </div>
          <div class="flex flex-col gap-4 sm:flex-row">
            <a href={ASSESSMENT_HREF} class="btn-primary">Start My Assessment</a>
            <a href={HOW_IT_WORKS_HREF} class="btn">See How It Works</a>
          </div>
        </div>
        <aside class="lg:col-span-5">
          <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-none dark:border-slate-800 dark:bg-slate-900">
            <img
              src="/assets/hubs/company-registration.svg"
              alt=""
              class="mb-5 h-20 w-20 rounded-md object-cover"
              width="80"
              height="80"
            />
            <h2 class="mb-3 text-xl font-bold text-slate-900 dark:text-white">Your ambitions don't have to stop at borders.</h2>
            <p class="mb-5 text-sm leading-relaxed text-muted dark:text-slate-400">
              Whether you're launching a new company, expanding an existing business or exploring an international
              structure, the first step is understanding the process.
            </p>
            <p class="text-sm text-muted dark:text-slate-400">
              We prepare, guide, organize and support. We do not control government or regulatory decisions.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/config';
import { ASSESSMENT_HREF, HOW_IT_WORKS_HREF, WHATSAPP_HREF, HOME_SERVICES } from '../lib/home';

const company = HOME_SERVICES.find((s) => s.id === 'company')!;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Business Registration', item: `${SITE.url}/business-registration/` },
  ],
};

const faqs = [
  {
    q: 'Does company registration give me a visa or residency?',
    a: 'No. Company formation and immigration are separate processes. Registration does not automatically provide immigration status, residency, a visa, a work permit or the right to operate in a particular country.',
  },
  {
    q: 'Which jurisdictions can you help with?',
    a: 'We provide remote documentation support for company formation in the United States, United Kingdom, Canada, Australia and selected European jurisdictions. Each jurisdiction has its own legal, tax and regulatory requirements.',
  },
  {
    q: 'Do you guarantee that the company will be approved?',
    a: 'No. Official authorities make registration and regulatory decisions. We explain the process and support documentation preparation.',
  },
  {
    q: 'Are government registration fees included?',
    a: 'No. Our service fee is for guidance and documentation support. Government and third-party charges are separate and paid to the relevant authorities or providers.',
  },
];

const jsonLd = [
  breadcrumbSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<BaseLayout
  title="International Company Registration — SK Immigration"
  description="Remote company formation and documentation support for the United States, United Kingdom, Canada, Australia and selected European jurisdictions. Company registration does not grant a visa or residency."
  canonical="/business-registration/"
  jsonLd={jsonLd}
  schemaVariant="global"
>
  <section class="not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:py-20">
      <div class="mb-10 md:mx-auto md:mb-12 max-w-3xl text-center">
        <p class="text-base font-semibold uppercase tracking-wide text-primary">International Company Registration</p>
        <h1 class="font-heading mb-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          Start your company internationally — with clearer guidance.
        </h1>
        <p class="text-xl text-muted dark:text-slate-400">
          Company formation and immigration are separate processes. We'll explain both so you don't mix them up.
        </p>
      </div>

      <div class="mx-auto max-w-4xl space-y-12">
        <div>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Why this can feel complicated</h2>
          <p class="mb-4 leading-relaxed text-muted dark:text-slate-400">{company.description}</p>
          <p class="leading-relaxed text-muted dark:text-slate-400">{company.extra}</p>
        </div>

        <div>
          <h2 class="font-heading mb-4 text-2xl font-bold text-slate-900 dark:text-white">Jurisdictions we can help you understand</h2>
          <div class="flex flex-wrap gap-3">
            {company.markets?.map((market) => (
              <span class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
                {market}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Who this is for</h2>
          <ul class="space-y-2 text-muted dark:text-slate-400">
            <li>Entrepreneurs planning to establish a company in another country</li>
            <li>Founders exploring an international structure</li>
            <li>Businesses expanding documentation across borders</li>
          </ul>
        </div>

        <div>
          <h2 class="font-heading mb-4 text-2xl font-bold text-slate-900 dark:text-white">What we help with</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {company.benefits.map((item) => (
              <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
                <span class="mt-0.5 text-primary" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">How the process usually works</h2>
          <ol class="space-y-4">
            {[
              'Tell us what you are trying to build and where.',
              'We explain the likely registration pathway, documents and scope.',
              'You receive a written service scope before payment.',
              'We support the agreed documentation and coordination.',
              'Official authorities review and decide the registration.',
            ].map((step, i) => (
              <li class="flex gap-3 text-muted dark:text-slate-400">
                <span class="font-heading font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <div>
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Information we typically need</h2>
          <p class="leading-relaxed text-muted dark:text-slate-400">
            Proposed country, company purpose, founder/shareholder details, and any existing business documents you
            already have. Exact lists depend on the jurisdiction. We'll explain this before you commit.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="mb-2 text-lg font-bold text-slate-900 dark:text-white">Our service fee</h2>
            <p class="text-sm leading-relaxed text-muted dark:text-slate-400">
              Charged by SK Immigration for the agreed documentation and guidance work, confirmed in writing first.
            </p>
          </div>
          <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="mb-2 text-lg font-bold text-slate-900 dark:text-white">Government / third-party fees</h2>
            <p class="text-sm leading-relaxed text-muted dark:text-slate-400">
              Registration authorities, filings, notaries and other providers charge separately. Those are not our
              service fee.
            </p>
          </div>
        </div>

        <div class="space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-6 dark:border-amber-700/50 dark:bg-amber-900/20">
          <h2 class="text-lg font-bold text-amber-950 dark:text-amber-100">What company registration does not provide</h2>
          {company.disclaimers?.map((d) => (
            <p class="text-sm leading-relaxed text-amber-900 dark:text-amber-200">{d}</p>
          ))}
        </div>

        <div>
          <h2 class="font-heading mb-6 text-2xl font-bold text-slate-900 dark:text-white">Questions</h2>
          <div class="divide-y divide-slate-200 dark:divide-slate-800">
            {faqs.map((faq) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-slate-800 dark:text-slate-200">
                  <span>{faq.q}</span>
                  <span class="ml-4 text-primary" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-sm text-muted dark:text-slate-400">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="rounded-md bg-slate-50 px-6 py-10 text-center dark:bg-slate-900">
          <h2 class="font-heading mb-3 text-2xl font-bold text-slate-900 dark:text-white">Ready to talk through a structure?</h2>
          <p class="mb-6 text-muted dark:text-slate-400">Tell us what you're trying to build. We'll help you understand the steps involved.</p>
          <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href={ASSESSMENT_HREF} class="btn-primary">Start Business Assessment</a>
            <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">Chat on WhatsApp</a>
            <a href={HOW_IT_WORKS_HREF} class="btn">See How It Works</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

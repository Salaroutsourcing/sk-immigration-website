---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getRelatedBlog, publishedStories, storyAmpPath, storyFunnelCta, storyHtmlPath } from '../../../lib/content';
import { SITE, absoluteUrl } from '../../../lib/site';
import { basePageGraph, webStoryArticleSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const items = await publishedStories();
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const blog = await getRelatedBlog(entry.data.relatedBlog);
const path = storyHtmlPath(entry.id);
const ampPath = storyAmpPath(entry.id);
const durationMs = `${entry.data.durationSeconds * 1000}ms`;
const cta = storyFunnelCta(entry, blog);
---

<BaseLayout
  title={`${entry.data.title} | Web Story | ${SITE.brand}`}
  description={entry.data.description}
  canonical={path}
  amphtml={ampPath}
  image={entry.data.posterPortrait}
  type="article"
  published={entry.data.publishDate}
  page="story"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Stories', path: '/stories/' },
      { name: entry.data.title, path },
    ]),
    webStoryArticleSchema({
      headline: entry.data.title,
      description: entry.data.description,
      url: absoluteUrl(ampPath),
      datePublished: entry.data.publishDate,
      dateModified: entry.data.updatedDate,
      image: entry.data.posterPortrait,
      keywords: entry.data.keywords,
      relatedBlog: entry.data.relatedBlog,
    }),
  ]}
>
  <div class="story-stage">
    <article
      class="story-frame"
      data-story
      style={`--story-ms: ${durationMs}; --slide-bg: url('${entry.data.posterPortrait}')`}
    >
      <div class="story-progress" aria-hidden="true">
        {entry.data.slides.map((_, index) => (
          <span data-bar={index}>
            <i></i>
          </span>
        ))}
      </div>
      {entry.data.slides.map((slide, index) => (
        <section class:list={['story-slide', { 'is-active': index === 0 }]} data-slide={index}>
          <p class="platform-kicker">{entry.data.category.replace('-', ' ')}</p>
          <h1>{slide.heading}</h1>
          <p>{slide.text}</p>
        </section>
      ))}
      <div class="story-nav">
        <button type="button" data-story-prev aria-label="Previous slide"></button>
        <button type="button" data-story-next aria-label="Next slide"></button>
      </div>
      <div class="story-cta">
        <a href={cta.href}>{cta.label}</a>
      </div>
    </article>
    <p class="story-amp-note">
      <a href={ampPath}>Open AMP Web Story</a>
      — this is the Discover version Google reads.
    </p>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector('[data-story]');
  if (root) {
    const slides = [...root.querySelectorAll('[data-slide]')];
    const bars = [...root.querySelectorAll('[data-bar]')];
    const ms = parseInt(getComputedStyle(root).getPropertyValue('--story-ms'), 10) || 12000;
    let index = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      bars.forEach((bar, i) => {
        bar.classList.toggle('is-done', i < index);
        bar.classList.toggle('is-active', i === index);
      });
      window.clearTimeout(timer);
      timer = window.setTimeout(() => show(index + 1), ms);
    };

    root.querySelector('[data-story-next]')?.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-story-prev]')?.addEventListener('click', () => show(index - 1));
    show(0);
  }
</script>

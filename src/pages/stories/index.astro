---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedStories, storyAmpPath, storyHtmlPath } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';

const items = await publishedStories();
---

<BaseLayout
  title={`Web Stories | ${SITE.brandFull}`}
  description="Fast, mobile-first visa stories. Every story ends on a long-form blog so traffic can rank, convert, and earn."
  canonical="/stories/"
  page="story"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Stories', path: '/stories/' },
    ]),
    collectionPageSchema({
      name: `Web Stories | ${SITE.brandFull}`,
      description: 'Fast, mobile-first visa stories. Every story ends on a long-form blog.',
      url: absoluteUrl('/stories/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: storyAmpPath(entry.id),
      })),
    }),
  ]}
>
  <section class="platform-wrap">
    <p class="platform-kicker">Web Stories · 5 / day target</p>
    <header class="platform-hero">
      <h1>Stories that land on blogs</h1>
      <p class="lede">
        Tap-through recaps for Discover and social. The last screen always opens a deep guide — never a dead end.
      </p>
    </header>
    <div class="platform-grid">
      {items.map((entry) => (
        <ContentCard
          kind="story"
          href={storyHtmlPath(entry.id)}
          ampHref={storyAmpPath(entry.id)}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedStories, storyAmpPath, storyHtmlPath } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { basePageGraph, collectionPageSchema } from '../../lib/seo';

const items = await publishedStories();
---

<BaseLayout
  title={`Web Stories | ${SITE.brandFull}`}
  description="Fast, mobile-first visa stories. Every story ends on a long-form blog so traffic can rank, convert, and earn."
  canonical="/stories/"
  page="story"
  jsonLd={[
    ...basePageGraph([
      { name: 'Home', path: '/' },
      { name: 'Stories', path: '/stories/' },
    ]),
    collectionPageSchema({
      name: `Web Stories | ${SITE.brandFull}`,
      description: 'Fast, mobile-first visa stories. Every story ends on a long-form blog.',
      url: absoluteUrl('/stories/'),
      items: items.map((entry) => ({
        name: entry.data.title,
        url: storyAmpPath(entry.id),
      })),
    }),
  ]}
>
  <section class="not-prose">
    <div class="page-intro max-w-4xl">
      <p class="eyebrow">Web Stories</p>
      <span class="accent-line mx-auto"></span>
      <h1 class="font-heading mt-3 mb-4 text-3xl font-bold tracking-tight text-ink md:text-5xl dark:text-white">Stories that land on blogs</h1>
      <p class="mx-auto max-w-2xl text-base leading-[1.65] text-muted">
        Tap-through recaps for Discover and social. The last screen always opens a deep guide.
      </p>
    </div>
  </section>
  <section class="section-container not-prose">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((entry) => (
        <ContentCard
          kind="story"
          href={storyHtmlPath(entry.id)}
          ampHref={storyAmpPath(entry.id)}
          title={entry.data.title}
          excerpt={entry.data.description}
          date={entry.data.publishDate}
          category={entry.data.category}
        />
      ))}
    </div>
    <AdSlot placement="in-feed" />
  </section>
</BaseLayout>

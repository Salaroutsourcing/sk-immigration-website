{
  "name": "sk-immigration-website",
  "version": "1.0.0",
  "private": true,
  "description": "SK Immigration Services — static site plus Cloudflare Worker lead API",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:answers-hub": "node scripts/build-answers-hub.mjs",
    "build:legacy-redirect": "node scripts/build-legacy-redirect.mjs",
    "db:create": "wrangler d1 create sk-immigration-leads",
    "db:migrate": "wrangler d1 execute sk-immigration-leads --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute sk-immigration-leads --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}

{
  "name": "sk-immigration-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SK Immigration Services — Astro static content platform plus Cloudflare Worker lead API",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "cf:dev": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "build:answers-hub": "node scripts/build-answers-hub.mjs",
    "build:legacy-redirect": "node scripts/build-legacy-redirect.mjs",
    "inject:consent": "node scripts/inject-consent-mode.mjs",
    "db:create": "wrangler d1 create sk-immigration-leads",
    "db:migrate": "wrangler d1 execute sk-immigration-leads --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute sk-immigration-leads --local --file=./schema.sql"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}

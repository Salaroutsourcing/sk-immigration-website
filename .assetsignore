# Everything listed here stays out of the public asset bundle.
# The site is deployed from the repo root, so without this the whole
# repository (including backend source, secrets and internal notes) would be
# downloadable from the live domain.

.git
.github
.gitignore
.assetsignore
.wrangler
.dev.vars
.dev.vars.example
.env
.env.example
node_modules
src
scripts
apps-script
schema.sql
package.json
package-lock.json
wrangler.jsonc
wrangler.toml
*.md
